// ============================================================================
// Botella Aura — Prisma schema
// ----------------------------------------------------------------------------
// Designed up front for the full 10-sprint roadmap so later sprints do not
// require painful migrations. Sprint 1 actively USES: User, Company,
// CompanyMember, Account, Session, VerificationToken, PasswordResetToken,
// AuditLog. The remaining models (LinkedInConnection, ContentDraft,
// TrendDigest, CompetitorProfile) are scaffolded now and wired up in the
// sprint noted on each model.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev. The rhel target is required for Netlify/Vercel
  // serverless functions (AWS Lambda / Amazon Linux) — without it, Prisma
  // throws "Query engine library for current platform could not be found"
  // at runtime in production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries: use the POOLED connection string in serverless (Neon /
  // Supabase pooler). Serverless functions open many short-lived connections,
  // so pooling prevents exhausting Postgres connection limits.
  url       = env("DATABASE_URL")
  // Migrations: must use a DIRECT (non-pooled) connection. PgBouncer's
  // transaction pooling breaks the advisory locks `prisma migrate deploy`
  // relies on. If your provider gives you only one URL, set DIRECT_URL to the
  // same value as DATABASE_URL — that is always safe.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// System-wide role on the User record. Distinct from CompanyRole, which is
/// the per-company membership role used for RBAC inside a workspace.
enum SystemRole {
  OWNER
  ADMIN
  MEMBER
}

/// Per-company membership role. Drives workspace RBAC (e.g. only OWNER/ADMIN
/// may edit company settings or manage billing in later sprints).
enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

/// Lifecycle of a LinkedIn connection (Sprint 2). Scaffolded now.
enum LinkedInConnectionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

/// Content types Aura can generate (Sprint 3+). Scaffolded now.
enum ContentType {
  LINKEDIN_POST
  CAROUSEL
  TWEET_THREAD
  BLOG
}

/// Approval lifecycle for generated content. The core human-in-the-loop
/// guarantee: nothing reaches PUBLISHED without passing through APPROVED.
enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

/// Typed audit actions. Kept as an enum (not free strings) so the audit trail
/// stays queryable and consistent as new sprints add actions.
enum AuditAction {
  USER_SIGNED_UP
  USER_LOGGED_IN
  USER_LOGGED_OUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_MEMBER_ADDED
  COMPANY_MEMBER_REMOVED
  ONBOARDING_COMPLETED
  // --- Sprint 2 (Trend Intelligence + LinkedIn) ---
  LINKEDIN_CONNECTED
  LINKEDIN_DISCONNECTED
  LINKEDIN_TOKEN_REFRESHED
  TREND_CONFIG_UPDATED
  TREND_DIGEST_GENERATED
  TREND_DIGEST_REQUESTED
  AI_SUGGESTION_GENERATED
  // --- Sprint 3 (Content Studio) ---
  KNOWLEDGE_SOURCE_SYNCED
  KNOWLEDGE_DOCUMENT_UPLOADED
  BRAND_VOICE_GENERATED
  BRAND_VOICE_UPDATED
  CONTENT_DRAFT_CREATED
  CONTENT_REGENERATED
  CONTENT_SUBMITTED_FOR_APPROVAL
  CONTENT_CHANGES_REQUESTED
  CONTENT_APPROVED
  CONTENT_REJECTED
  CONTENT_SCHEDULED
  CONTENT_PUBLISHED
  // --- Sprint 4 (Competitor Intelligence) ---
  COMPETITOR_ADDED
  COMPETITOR_UPDATED
  COMPETITOR_REMOVED
  COMPETITOR_SNAPSHOT_CAPTURED
  COMPETITOR_REPORT_REQUESTED
  COMPETITOR_REPORT_GENERATED
  // --- Sprint 4 (Chrome Extension — the human action layer) ---
  EXTENSION_TOKEN_ISSUED
  EXTENSION_TOKEN_REVOKED
  EXTENSION_ACTION_COMPLETED
  // --- Sprint 4 (Outreach Intelligence) ---
  OUTREACH_CONFIG_UPDATED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_REMOVED
  LEAD_SIGNAL_DETECTED
  OUTREACH_DRAFTED
  OUTREACH_SUBMITTED_FOR_APPROVAL
  OUTREACH_APPROVED
  OUTREACH_REJECTED
  OUTREACH_SENT
  // --- Sprint 4 (Engagement Copilot) ---
  ENGAGEMENT_TARGET_ADDED
  ENGAGEMENT_TARGET_REMOVED
  ENGAGEMENT_COMMENT_DRAFTED
  ENGAGEMENT_COMMENT_POSTED
  // --- Sprint 5 (Lead Discovery Engine) ---
  DISCOVERY_PROFILE_CREATED
  DISCOVERY_PROFILE_UPDATED
  DISCOVERY_PROFILE_DELETED
  DISCOVERY_RUN_STARTED
  DISCOVERY_RUN_COMPLETED
  LEAD_DISCOVERED
  LEAD_SCORED
  // --- Sprint 5 (Marketing Memory / Learning Loop) ---
  PERFORMANCE_SNAPSHOT_CAPTURED
  OUTREACH_OUTCOME_UPDATED
  MARKETING_MEMORY_GENERATED
}

/// Sprint 3 — origin of an ingested knowledge chunk.
enum KnowledgeSourceType {
  WEBSITE
  BLOG
  UPLOAD
  PAST_POST
}

/// Sprint 3 — sync lifecycle of a tracked knowledge source.
enum KnowledgeSourceStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
}

/// Sprint 3 — campaign lifecycle (Campaign Builder UI lands a later sprint).
enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Sprint 4 — lead lifecycle in the Outreach module.
enum LeadStatus {
  NEW
  QUALIFIED
  DRAFTED
  CONTACTED
  ARCHIVED
}

/// Sprint 4 — kinds of public buying/relevance signal detected for a lead.
enum SignalType {
  FUNDING
  HIRING
  GITHUB_ACTIVITY
  NEWS
  LEADERSHIP_CHANGE
}

/// Sprint 4 — outreach message kinds. Followups are only sent AFTER a
/// connection is accepted (tracked via the extension, not an API).
enum OutreachType {
  CONNECTION_NOTE
  FOLLOWUP
}

/// Sprint 4 — approval lifecycle for outreach messages. Mirrors ContentStatus:
/// nothing reaches SENT without an explicit human Approve + a human click in
/// the extension.
enum OutreachStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

/// Sprint 4 — Engagement Copilot comment lifecycle.
enum EngagementStatus {
  DRAFT
  POSTED
  DISCARDED
}

/// Sprint 5 — how a Lead entered the system. SIGNAL = Sprint 4 reactive
/// detection; DISCOVERY_ENGINE = Sprint 5 proactive prospecting; MANUAL = added
/// by the user. Existing Sprint 4 leads default to SIGNAL.
enum LeadSource {
  SIGNAL
  DISCOVERY_ENGINE
  MANUAL
}

/// Sprint 5 — lifecycle of a discovery run.
enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Sprint 5 — category of a learned marketing insight.
enum InsightType {
  CONTENT_FORMAT
  CONTENT_LENGTH
  TIMING
  TOPIC
  HASHTAG
  OUTREACH_APPROACH
  OTHER
}

/// Sprint 5 — confidence in an insight, derived from sample size.
enum MemoryConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Sprint 5 — where a performance metric came from. LinkedIn API analytics are
/// unavailable at our current scope (honest "unavailable"); real numbers come
/// from the extension DOM-read or a manual human toggle.
enum PerformanceSource {
  LINKEDIN_API
  EXTENSION_DOM
  MANUAL
}

// ---------------------------------------------------------------------------
// Core identity + auth (Sprint 1)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  /// Nullable: OAuth-only users (e.g. Google) have no local password.
  passwordHash  String?
  name          String?
  image         String?
  role          SystemRole @default(OWNER)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         CompanyMember[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  createdContent      ContentDraft[]       @relation("ContentCreatedBy")
  extensionTokens     ExtensionToken[]

  @@index([email])
}

/// NextAuth OAuth account linkage. Adding LinkedIn in Sprint 2 requires NO
/// schema change here — it is just another row with provider = "linkedin".
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Password reset via single-use, hashed, expiring tokens (Sprint 1).
/// We store only a SHA-256 hash of the token; the raw token lives only in the
/// emailed link. See server/services/auth-token.service.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspace / tenancy (Sprint 1)
// ---------------------------------------------------------------------------

/// A Company is the tenant boundary. Everything the AI produces is scoped to a
/// company. `preferences` is an extensible JSON bag for onboarding/AI-prompt
/// data so later sprints can add signals without a migration; well-known
/// fields (brandVoiceNotes, industry, website) stay as explicit columns.
model Company {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  website           String?
  industry          String?
  brandVoiceNotes   String?   @db.Text
  logoUrl           String?
  preferences       Json      @default("{}")
  /// Sprint 3 — AI-generated, human-editable brand voice profile (see
  /// server/content/brand-voice.service.ts). Injected into every generation.
  brandVoiceProfile Json?
  onboardedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members             CompanyMember[]
  auditLogs           AuditLog[]
  linkedInConnections LinkedInConnection[]
  contentDrafts       ContentDraft[]
  trendDigests        TrendDigest[]
  competitorProfiles  CompetitorProfile[]
  competitorReports   CompetitorReport[]
  trendConfig         CompanyTrendConfig?
  knowledgeSources    KnowledgeSource[]
  knowledgeChunks     KnowledgeChunk[]
  campaigns           Campaign[]
  extensionTokens     ExtensionToken[]
  leads               Lead[]
  outreachMessages    OutreachMessage[]
  outreachConfig      OutreachConfig?
  engagementTargets   EngagementTarget[]
  engagementComments  EngagementComment[]
  discoveryProfiles   DiscoveryProfile[]
  discoveryRuns       DiscoveryRun[]
  performanceSnapshots PerformanceSnapshot[]
  marketingMemories   MarketingMemory[]

  @@index([slug])
}

/// User <-> Company join with a per-company role (RBAC).
model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole @default(MEMBER)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Trust & safety — audit trail (Sprint 1, used forever)
// ---------------------------------------------------------------------------

/// Append-only audit trail. Every meaningful business action — every AI
/// suggestion, every human approval, every publish — is recorded here. This is
/// a product principle (transparency/trust + future explainability), not
/// optional. `userId`/`companyId` are nullable to allow system events and
/// pre-company events (e.g. signup before any company exists).
model AuditLog {
  id        String      @id @default(cuid())
  companyId String?
  userId    String?
  action    AuditAction
  /// Free-form structured context: what changed, which entity, AI rationale.
  metadata  Json        @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Sprint 2+ placeholders (scaffolded now; wired up in the noted sprint)
// ---------------------------------------------------------------------------

/// Sprint 2 — official LinkedIn OAuth connection, scoped to a company.
/// accessToken/refreshToken are stored ENCRYPTED at rest (AES-256-GCM via
/// lib/crypto.ts). No scraping, no unofficial API — official OAuth only.
model LinkedInConnection {
  id              String                   @id @default(cuid())
  companyId       String
  linkedInUserId  String?
  /// Connected profile display (from OIDC userinfo) — safe, non-secret, shown in UI.
  displayName     String?
  avatarUrl       String?
  /// Ciphertext (base64). Never store raw tokens.
  accessTokenEnc  String?                  @db.Text
  refreshTokenEnc String?                  @db.Text
  scope           String?
  expiresAt       DateTime?
  status          LinkedInConnectionStatus @default(PENDING)
  /// Populated when status = ERROR/EXPIRED to explain the reconnect prompt.
  errorMessage    String?
  connectedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // One connection per company for Sprint 2 (upserted on connect).
  @@unique([companyId])
}

/// Sprint 3 — AI-generated content pending human approval before publish.
/// `body` holds the structured, Zod-validated content per type (see
/// lib/validations/content.ts). Nothing reaches PUBLISHED without an explicit
/// human Approve action — enforced in server/content/content.service.ts.
model ContentDraft {
  id              String        @id @default(cuid())
  companyId       String
  createdById     String?
  campaignId      String?
  type            ContentType
  status          ContentStatus @default(DRAFT)
  title           String?
  /// Rich body: structured JSON per content type.
  body            Json          @default("{}")
  /// Generation context: { source: {kind, ref, brief}, model, promptVersion,
  /// knowledgeChunkIds, brandVoiceApplied }.
  aiMetadata      Json          @default("{}")
  rejectionReason String?       @db.Text
  scheduledFor    DateTime?
  publishedAt     DateTime?
  /// LinkedIn post URN/URL after a successful official-API publish.
  publishedUrl    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  performanceSnapshots PerformanceSnapshot[]

  @@index([companyId, status])
  @@index([companyId, scheduledFor])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Sprint 3 — Content Studio: knowledge base, campaigns
// ---------------------------------------------------------------------------

/// A tracked ingestion source (website/blog) with sync status. Uploads create
/// chunks directly and are summarized on the ingestion page from KnowledgeChunk.
model KnowledgeSource {
  id           String                @id @default(cuid())
  companyId    String
  type         KnowledgeSourceType
  url          String?
  label        String
  status       KnowledgeSourceStatus @default(PENDING)
  lastSyncedAt DateTime?
  error        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, url])
  @@index([companyId])
}

/// A retrievable chunk of the company's own content, grounding AI generation.
model KnowledgeChunk {
  id         String              @id @default(cuid())
  companyId  String
  sourceType KnowledgeSourceType
  sourceUrl  String?
  title      String?
  content    String              @db.Text
  tokenCount Int?
  createdAt  DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sourceType])
}

/// Sprint 3 stub — Campaign Builder UI arrives in a later sprint. Content can
/// already be tagged to a campaign at generation time.
model Campaign {
  id        String         @id @default(cuid())
  companyId String
  name      String
  goal      String?        @db.Text
  status    CampaignStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts  ContentDraft[]

  @@index([companyId])
}

/// Sprint 2 — daily trend intelligence digests per company.
/// `payload` holds the structured digest:
///   { items: [{ id, title, source, url, score, aiSummary, suggestedAngle }],
///     generatedAt, model, sources: {...counts} }
model TrendDigest {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Idempotency: one digest per company per calendar day (see NON-NEGOTIABLE #6).
  @@unique([companyId, date])
  @@index([companyId])
}

/// Sprint 2 — per-company Trend Intelligence configuration. 1:1 with Company.
/// String[] columns use native Postgres text[]. Smart defaults are seeded from
/// onboarding data (industry + brand voice) via a one-time Claude call, then
/// fully user-editable on /dashboard/settings/trends.
model CompanyTrendConfig {
  id              String   @id @default(cuid())
  companyId       String   @unique
  /// Topics/phrases relevant to the company's market.
  keywords        String[] @default([])
  /// Subreddits to monitor (names without the "r/" prefix).
  subreddits      String[] @default([])
  /// Additional RSS feed URLs to ingest alongside keyword-based Google News.
  rssFeeds        String[] @default([])
  /// Lightweight competitor watch list (names). The richer CompetitorProfile
  /// table (Sprint 5) is the system of record; this feeds trend mention checks.
  competitorNames String[] @default([])
  /// Which sources are enabled: { reddit, hackernews, news, twitter }.
  enabledSources  Json     @default("{\"reddit\":true,\"hackernews\":true,\"news\":true,\"twitter\":false}")
  /// True once smart defaults have been generated, so we don't overwrite edits.
  defaultsSeeded  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Sprint 4 — tracked competitor profiles per company. Signal is gathered ONLY
/// from legitimate public sources (website diff, public news/RSS, GitHub API).
/// The public LinkedIn Company Page feed is NOT read (no official API scope) —
/// see server/competitors/sources/linkedin.ts, which is a flagged stub.
model CompetitorProfile {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  /// Homepage / primary website URL (tracked for change detection).
  url             String?
  /// Optional pricing page URL (tracked separately from homepage).
  pricingUrl      String?
  /// Optional public LinkedIn Company Page URL (display + future API scope).
  linkedInUrl     String?
  /// Optional GitHub org/user login for public repo-activity signal.
  githubOrg       String?
  notes           String?  @db.Text
  /// When false, the tracking pipeline skips this competitor.
  trackingEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@index([companyId])
}

/// Sprint 4 — a point-in-time capture of a competitor's public signal. Each run
/// hashes the homepage/pricing text and, when content changed vs the previous
/// snapshot, stores a Claude-written human-readable `changesSummary`.
model CompetitorSnapshot {
  id             String   @id @default(cuid())
  competitorId   String
  capturedAt     DateTime @default(now())
  /// SHA-256 of normalized homepage text (fast change detection).
  homepageHash   String?
  /// Extracted, normalized homepage text (bounded) for diffing/summary.
  homepageText   String?  @db.Text
  pricingHash    String?
  pricingText    String?  @db.Text
  /// Structured, human-readable diff:
  ///   { hasChanges, homepage?: string, pricing?: string, news: [...],
  ///     github?: {...}, model }
  changesSummary Json     @default("{}")
  createdAt      DateTime @default(now())

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
}

/// Sprint 4 — weekly aggregated competitor intelligence report per company.
/// `payload` holds the structured, Claude-generated digest:
///   { competitors: [{ competitor, newLaunches, pricingChanges,
///     notableActivity, strategicTakeaway }], synthesis, generatedAt, model }
model CompetitorReport {
  id          String   @id @default(cuid())
  companyId   String
  /// Monday 00:00 UTC of the ISO week the report covers (idempotency key).
  weekStart   DateTime
  weekEnd     DateTime
  payload     Json     @default("{}")
  model       String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStart])
  @@index([companyId, weekStart])
}

// ---------------------------------------------------------------------------
// Sprint 4 — Chrome Extension (the human action layer)
// ---------------------------------------------------------------------------

/// A revocable, per-user bearer token for the companion Chrome Extension.
/// SECURITY: we store ONLY sha256(rawToken) — the raw token lives only in the
/// extension's chrome.storage.local. This token authorizes ONLY the
/// /api/extension/* endpoints (queue read + action sync-back), never the full
/// web session. It is scoped to one workspace (companyId) and independently
/// revocable, so a compromised extension token cannot escalate to account
/// access. See server/extension/token.service.ts + lib/extension-auth.ts.
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  companyId  String
  /// Human label (e.g. browser/device) shown in settings.
  label      String?
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Sprint 4 — Outreach Intelligence
// ---------------------------------------------------------------------------

/// Per-company outreach targeting config (1:1 with Company). Mirrors
/// CompanyTrendConfig. Drives which public signal sources run and how leads are
/// filtered. String[] use native Postgres text[].
model OutreachConfig {
  id             String   @id @default(cuid())
  companyId      String   @unique
  /// Target industries/keywords the company sells into.
  industries     String[] @default([])
  /// Role titles worth reaching (e.g. "Head of Marketing").
  roleTitles     String[] @default([])
  /// Company size/stage filters (free-form tags, e.g. "seed", "50-200").
  companyStages  String[] @default([])
  /// Which signal sources are on: { crunchbase, github, jobs, news }.
  enabledSources Json     @default("{\"crunchbase\":false,\"github\":true,\"jobs\":true,\"news\":true}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// A potential outreach target. Sourced from public signal at COMPANY
/// granularity; a person's name/title/LinkedIn URL are added/confirmed by the
/// user (never scraped from LinkedIn).
model Lead {
  id                String     @id @default(cuid())
  companyId         String
  /// Person name — optional until the user confirms it.
  name              String?
  title             String?
  /// The target organization the signal is about.
  companyName       String
  sourceUrl         String?
  /// Publicly-discoverable profile URL, manually confirmed by the user.
  linkedInProfileUrl String?
  status            LeadStatus @default(NEW)
  /// Sprint 5 — how this lead entered the system.
  source            LeadSource @default(SIGNAL)
  /// Sprint 5 — the DiscoveryProfile that found this lead (if discovered).
  discoveryProfileId String?
  /// Sprint 5 — AI fit score 0-100 against the discovery profile's criteria.
  fitScore          Int?
  /// Sprint 5 — short "why this lead" rationale (traceable, human-readable).
  fitRationale      String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discoveryProfile DiscoveryProfile? @relation(fields: [discoveryProfileId], references: [id], onDelete: SetNull)
  signals          LeadSignal[]
  messages         OutreachMessage[]

  @@index([companyId, status])
  @@index([companyId, source])
}

/// A detected public signal attached to a lead (funding, hiring, etc.).
model LeadSignal {
  id          String     @id @default(cuid())
  leadId      String
  signalType  SignalType
  description String     @db.Text
  sourceUrl   String?
  detectedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// An AI-drafted outreach message pending human approval, then a human send via
/// the extension. Nothing reaches SENT without both.
model OutreachMessage {
  id        String         @id @default(cuid())
  leadId    String
  companyId String
  type      OutreachType
  status    OutreachStatus @default(DRAFT)
  draftText String         @db.Text
  /// Generation context: { model, promptVersion, signalId, brandVoiceApplied }.
  aiMetadata Json          @default("{}")
  rejectionReason String?
  sentAt    DateTime?
  /// Sprint 5 — the "did it work" outcome signals, manually confirmed by the
  /// user (no API exposes these). Feed the Marketing Memory learning loop.
  connectionAccepted Boolean @default(false)
  replyReceived      Boolean @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performanceSnapshots PerformanceSnapshot[]

  @@index([companyId, status])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Sprint 5 — Lead Discovery Engine (proactive prospecting)
// ---------------------------------------------------------------------------

/// A saved, reusable search profile describing WHO the company wants to reach.
/// `criteria` is a structured JSON bag (industry, stage, roleTitles, geography,
/// keywords) validated by lib/validations/discovery.ts. A profile can auto-run
/// weekly (autoRun) via the discovery cron.
model DiscoveryProfile {
  id        String   @id @default(cuid())
  companyId String
  name      String
  criteria  Json     @default("{}")
  isActive  Boolean  @default(true)
  autoRun   Boolean  @default(false)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    DiscoveryRun[]
  leads   Lead[]

  @@index([companyId])
}

/// One execution of a DiscoveryProfile against the public sources — the run
/// history surfaced at /dashboard/leads. `summary` records per-source counts +
/// skipped sources (transparency), so a run with 0 results is honestly empty.
model DiscoveryRun {
  id                 String             @id @default(cuid())
  companyId          String
  discoveryProfileId String
  status             DiscoveryRunStatus @default(RUNNING)
  leadsFound         Int                @default(0)
  leadsCreated       Int                @default(0)
  summary            Json               @default("{}")
  startedAt          DateTime           @default(now())
  finishedAt         DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile DiscoveryProfile @relation(fields: [discoveryProfileId], references: [id], onDelete: Cascade)

  @@index([companyId, startedAt])
  @@index([discoveryProfileId])
}

// ---------------------------------------------------------------------------
// Sprint 4 — Engagement Copilot
// ---------------------------------------------------------------------------

/// A public LinkedIn profile/page the user chose to monitor for engagement.
/// Monitoring happens ENTIRELY in the extension (DOM already shown to the user);
/// the backend never fetches these feeds.
model EngagementTarget {
  id         String   @id @default(cuid())
  companyId  String
  label      String
  profileUrl String
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, profileUrl])
  @@index([companyId])
}

/// An AI-drafted comment for a post the user was already viewing. The post text
/// is captured client-side by the extension and sent here to draft; the human
/// posts it with one click in the extension. The web app is the system of
/// record (read-only history at /dashboard/engagement).
model EngagementComment {
  id            String           @id @default(cuid())
  companyId     String
  createdById   String?
  targetPostUrl String
  targetAuthor  String?
  /// The visible post text the comment responds to (from the user's own DOM).
  postExcerpt   String?          @db.Text
  draftText     String           @db.Text
  status        EngagementStatus @default(DRAFT)
  aiMetadata    Json             @default("{}")
  postedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performanceSnapshots PerformanceSnapshot[]

  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Sprint 5 — Marketing Memory / Learning Loop
// ---------------------------------------------------------------------------

/// A captured performance measurement for a published item. `metrics` is a
/// source-shaped JSON bag (e.g. { impressions, likes, comments, clicks }).
/// NON-NEGOTIABLE #2: we never fabricate — a snapshot only exists when a real
/// source (LinkedIn API, the extension's DOM read of the user's own post, or a
/// manual entry) provided numbers.
model PerformanceSnapshot {
  id                 String            @id @default(cuid())
  companyId          String
  contentDraftId     String?
  outreachMessageId  String?
  engagementCommentId String?
  source             PerformanceSource
  metrics            Json              @default("{}")
  capturedAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentDraft      ContentDraft?      @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  outreachMessage   OutreachMessage?   @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)
  engagementComment EngagementComment? @relation(fields: [engagementCommentId], references: [id], onDelete: Cascade)

  @@index([companyId, capturedAt])
  @@index([contentDraftId])
}

/// A learned marketing insight extracted from real PerformanceSnapshot data.
/// NON-NEGOTIABLE #3: every insight references the data that supports it via
/// `supportingDataSummary`, and `confidence`/`sampleSize` are derived from how
/// much real data exists — never confident-sounding output from thin data.
model MarketingMemory {
  id                   String           @id @default(cuid())
  companyId            String
  insightType          InsightType
  insight              String           @db.Text
  confidence           MemoryConfidence @default(LOW)
  sampleSize           Int              @default(0)
  /// { basis: string, metric: string, itemIds: string[], ... } — traceable.
  supportingDataSummary Json            @default("{}")
  isActive             Boolean          @default(true)
  generatedAt          DateTime         @default(now())
  createdAt            DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, insightType])
  @@index([companyId, isActive])
}
