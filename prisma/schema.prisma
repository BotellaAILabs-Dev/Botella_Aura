/// Which social network a post is aimed at.
///
/// Deliberately separate from ContentType: the type describes the SHAPE of the
/// writing (a hook-first post, a carousel, a thread), the platform describes
/// where it goes. The same carousel body can be aimed at LinkedIn or Instagram,
/// and each wants a different image size and a different publisher. Null on a
/// draft means "whatever this content type defaults to" (see lib/platforms.ts),
/// so every pre-existing draft keeps behaving exactly as before.
enum SocialPlatform {
  LINKEDIN
  INSTAGRAM
  X
  FACEBOOK
}

/// Where an image came from.
///
/// Mostly image-generation backends behind ImageGenerationService — adding one
/// is additive, because Content Studio talks to the abstraction and never to a
/// vendor. UPLOAD is the exception: a graphic the user supplied themselves,
/// either from their machine or by URL. It lives in the same enum because the
/// rest of the pipeline (validation, storage, attachment, publishing) treats a
/// supplied image exactly like a generated one, and a separate model would
/// duplicate all of it.
enum ImageProvider {
  OPENAI
  GOOGLE
  AGNES
  HUGGINGFACE
  STABILITY
  REPLICATE
  UPLOAD
}

/// Where an asset's bytes actually live.
///
/// DATABASE is the default and needs no infrastructure: providers hand back
/// URLs that expire within the hour, so the bytes are pulled once and kept.
/// EXTERNAL means they were copied to an S3-compatible bucket instead (see
/// server/media/storage.ts) and `storageUrl` is authoritative.
enum AssetStorageKind {
  DATABASE
  EXTERNAL
}

/// Media that can hang off a post. Only IMAGE is produced today; VIDEO exists so
/// the attachment layer does not need reshaping when it arrives.
enum MediaKind {
  IMAGE
  VIDEO
}

/// Sprint 3 — origin of an ingested knowledge chunk.
enum KnowledgeSourceType {
  WEBSITE
  BLOG
  UPLOAD
  PAST_POST
}

/// What KIND of business material a document is.
///
/// `KnowledgeSourceType` says where a chunk came from (a website, an upload);
/// this says what it IS. The two answer different questions and both matter:
/// a PDF upload could be a pitch deck, a competitor teardown, or the brand
/// guidelines, and each of those should be used differently — guidelines steer
/// voice, differentiators steer claims, competitor intel steers positioning.
///
/// Without this every uploaded document was an undifferentiated blob scored
/// only on keyword overlap, so the one page stating what makes the company
/// different competed on equal terms with a stale blog post.
enum MaterialCategory {
  COMPANY_INFO
  PITCH_DECK
  BRAND_GUIDELINES
  AUDIENCE_ICP
  PRODUCT_DOCS
  DIFFERENTIATORS
  PAST_CAMPAIGN
  COMPETITOR_INTEL
  OTHER
}

/// Sprint 3 — sync lifecycle of a tracked knowledge source.
enum KnowledgeSourceStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
}

/// Sprint 3 — campaign lifecycle (Campaign Builder UI lands a later sprint).
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Sprint 6 — kinds of scheduled campaign work.
enum CampaignTaskType {
  GENERATE_CONTENT
  RUN_OUTREACH_BATCH
  RUN_DISCOVERY
  REVIEW_CHECKPOINT
}

/// Sprint 6 — lifecycle of a campaign task. Output still passes the normal
/// human approval gate — GENERATED means "a draft was produced for review".
enum CampaignTaskStatus {
  PENDING
  GENERATED
  APPROVED
  SKIPPED
  FAILED
}

/// Sprint 6 — subscription plan tiers. Prices live in Stripe (referenced by
/// env price IDs); this is only the entitlement tier.
enum Plan {
  TRIAL
  STARTER
  GROWTH
  AGENCY
}

/// Sprint 6 — subscription status (mirrors the Stripe subscription lifecycle).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Sprint 4 — lead lifecycle in the Outreach module.
enum LeadStatus {
  NEW
  QUALIFIED
  DRAFTED
  CONTACTED
  ARCHIVED
}

/// Sprint 4 — kinds of public buying/relevance signal detected for a lead.
enum SignalType {
  FUNDING
  HIRING
  GITHUB_ACTIVITY
  NEWS
  LEADERSHIP_CHANGE
}

/// Sprint 4 — outreach message kinds. Followups are only sent AFTER a
/// connection is accepted (tracked via the extension, not an API).
enum OutreachType {
  CONNECTION_NOTE
  FOLLOWUP
}

/// Sprint 4 — approval lifecycle for outreach messages. Mirrors ContentStatus:
/// nothing reaches SENT without an explicit human Approve + a human click in
/// the extension.
enum OutreachStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

/// Sprint 4 — Engagement Copilot comment lifecycle.
enum EngagementStatus {
  DRAFT
  POSTED
  DISCARDED
}

/// Sprint 5 — how a Lead entered the system. SIGNAL = Sprint 4 reactive
/// detection; DISCOVERY_ENGINE = Sprint 5 proactive prospecting; MANUAL = added
/// by the user. Existing Sprint 4 leads default to SIGNAL.
enum LeadSource {
  SIGNAL
  DISCOVERY_ENGINE
  MANUAL
}

/// Sprint 5 — lifecycle of a discovery run.
enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Sprint 5 — category of a learned marketing insight.
enum InsightType {
  CONTENT_FORMAT
  CONTENT_LENGTH
  TIMING
  TOPIC
  HASHTAG
  OUTREACH_APPROACH
  OTHER
}

/// Sprint 5 — confidence in an insight, derived from sample size.
enum MemoryConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Sprint 5 — where a performance metric came from. LinkedIn API analytics are
/// unavailable at our current scope (honest "unavailable"); real numbers come
/// from the extension DOM-read or a manual human toggle.
enum PerformanceSource {
  LINKEDIN_API
  EXTENSION_DOM
  MANUAL
}

// ---------------------------------------------------------------------------
// Core identity + auth (Sprint 1)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  /// Nullable: OAuth-only users (e.g. Google) have no local password.
  passwordHash  String?
  name          String?
  image         String?
  role          SystemRole @default(OWNER)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         CompanyMember[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  createdContent      ContentDraft[]       @relation("ContentCreatedBy")
  extensionTokens     ExtensionToken[]
  generatedAssets     GeneratedAsset[]     @relation("AssetCreatedBy")

  @@index([email])
}

/// NextAuth OAuth account linkage. Adding LinkedIn in Sprint 2 requires NO
/// schema change here — it is just another row with provider = "linkedin".
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Password reset via single-use, hashed, expiring tokens (Sprint 1).
/// We store only a SHA-256 hash of the token; the raw token lives only in the
/// emailed link. See server/services/auth-token.service.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspace / tenancy (Sprint 1)
// ---------------------------------------------------------------------------

/// A Company is the tenant boundary. Everything the AI produces is scoped to a
/// company. `preferences` is an extensible JSON bag for onboarding/AI-prompt
/// data so later sprints can add signals without a migration; well-known
/// fields (brandVoiceNotes, industry, website) stay as explicit columns.
model Company {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  website           String?
  industry          String?
  brandVoiceNotes   String?   @db.Text
  logoUrl           String?
  preferences       Json      @default("{}")
  /// Sprint 3 — AI-generated, human-editable brand voice profile (see
  /// server/content/brand-voice.service.ts). Injected into every generation.
  brandVoiceProfile Json?
  onboardedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members               CompanyMember[]
  invitations           CompanyInvitation[]
  auditLogs             AuditLog[]
  linkedInConnections   LinkedInConnection[]
  contentDrafts         ContentDraft[]
  trendDigests          TrendDigest[]
  competitorProfiles    CompetitorProfile[]
  competitorReports     CompetitorReport[]
  trendConfig           CompanyTrendConfig?
  knowledgeSources      KnowledgeSource[]
  knowledgeChunks       KnowledgeChunk[]
  campaigns             Campaign[]
  extensionTokens       ExtensionToken[]
  leads                 Lead[]
  outreachMessages      OutreachMessage[]
  outreachConfig        OutreachConfig?
  engagementTargets     EngagementTarget[]
  engagementComments    EngagementComment[]
  discoveryProfiles     DiscoveryProfile[]
  discoveryRuns         DiscoveryRun[]
  performanceSnapshots  PerformanceSnapshot[]
  marketingMemories     MarketingMemory[]
  campaignTasks         CampaignTask[]
  subscription          Subscription?
  analyticsReports      AnalyticsReport[]
  connections           Connection[]
  advisorReports        AdvisorReport[]
  marketingPlans        MarketingPlan[]
  intelligenceSnapshots IntelligenceSnapshot[]
  generationJobs        GenerationJob[]
  generatedAssets       GeneratedAsset[]
  contentMedia          ContentMedia[]
  briefings             WorkspaceBriefing[]
  contextSnapshot       BusinessContextSnapshot?
  contextQuestions      BusinessContextQuestion[]
  opportunities         Opportunity[]
  recommendations       Recommendation[]
  signals               Signal[]

  @@index([slug])
}

/// User <-> Company join with a per-company role (RBAC).
model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole @default(MEMBER)
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Truthful outcome of an outbound transactional email. The UI must never show
/// "sent" when the transport only logged to the console — that was the whole
/// bug behind "invitation shows Mail Sent but nothing arrives".
enum EmailDeliveryStatus {
  /// Queued but not attempted yet.
  PENDING
  /// A real provider accepted the message.
  SENT
  /// A real provider was configured but rejected/errored.
  FAILED
  /// No provider configured — the message was only logged locally.
  NOT_CONFIGURED
}

/// A pending invite for someone to join a company at a given role. We store
/// only a SHA-256 hash of the accept token (the raw token lives only in the
/// emailed link), mirroring PasswordResetToken. Single active invite per
/// (company, email).
model CompanyInvitation {
  id             String              @id @default(cuid())
  companyId      String
  email          String
  role           CompanyRole         @default(MEMBER)
  tokenHash      String              @unique
  status         InvitationStatus    @default(PENDING)
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime            @default(now())
  /// --- Real email-delivery outcome (never optimistic) ---
  emailStatus    EmailDeliveryStatus @default(PENDING)
  /// Which transport actually handled it: "smtp" | "resend" | "console".
  emailTransport String?
  /// Provider error detail when emailStatus = FAILED (surfaced to admins).
  emailError     String?             @db.Text
  emailSentAt    DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Trust & safety — audit trail (Sprint 1, used forever)
// ---------------------------------------------------------------------------

/// Append-only audit trail. Every meaningful business action — every AI
/// suggestion, every human approval, every publish — is recorded here. This is
/// a product principle (transparency/trust + future explainability), not
/// optional. `userId`/`companyId` are nullable to allow system events and
/// pre-company events (e.g. signup before any company exists).
model AuditLog {
  id        String      @id @default(cuid())
  companyId String?
  userId    String?
  action    AuditAction
  /// Free-form structured context: what changed, which entity, AI rationale.
  metadata  Json        @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Sprint 2+ placeholders (scaffolded now; wired up in the noted sprint)
// ---------------------------------------------------------------------------

/// Sprint 2 — official LinkedIn OAuth connection, scoped to a company.
/// accessToken/refreshToken are stored ENCRYPTED at rest (AES-256-GCM via
/// lib/crypto.ts). No scraping, no unofficial API — official OAuth only.
model LinkedInConnection {
  id              String                   @id @default(cuid())
  companyId       String
  linkedInUserId  String?
  /// Connected profile display (from OIDC userinfo) — safe, non-secret, shown in UI.
  displayName     String?
  avatarUrl       String?
  /// Ciphertext (base64). Never store raw tokens.
  accessTokenEnc  String?                  @db.Text
  refreshTokenEnc String?                  @db.Text
  scope           String?
  expiresAt       DateTime?
  status          LinkedInConnectionStatus @default(PENDING)
  /// Populated when status = ERROR/EXPIRED to explain the reconnect prompt.
  errorMessage    String?
  connectedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // One connection per company for Sprint 2 (upserted on connect).
  @@unique([companyId])
}

/// Sprint 3 — AI-generated content pending human approval before publish.
/// `body` holds the structured, Zod-validated content per type (see
/// lib/validations/content.ts). Nothing reaches PUBLISHED without an explicit
/// human Approve action — enforced in server/content/content.service.ts.
model ContentDraft {
  id              String        @id @default(cuid())
  companyId       String
  createdById     String?
  campaignId      String?
  type            ContentType
  status          ContentStatus @default(DRAFT)
  title           String?
  /// Rich body: structured JSON per content type.
  body            Json          @default("{}")
  /// Generation context: { source: {kind, ref, brief}, model, promptVersion,
  /// knowledgeChunkIds, brandVoiceApplied }.
  aiMetadata      Json          @default("{}")
  rejectionReason String?       @db.Text
  scheduledFor    DateTime?
  publishedAt     DateTime?
  /// LinkedIn post URN/URL after a successful official-API publish.
  publishedUrl    String?
  /// Where this post is aimed. Null = derive from `type` (lib/platforms.ts), so
  /// drafts created before platform targeting existed behave exactly as before.
  platform        SocialPlatform?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy            User?                 @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  campaign             Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  performanceSnapshots PerformanceSnapshot[]
  /// Media actually attached to this post, in carousel order.
  media                ContentMedia[]
  /// Every graphic ever generated FOR this draft — the graphic history, which
  /// outlives any individual attachment.
  generatedAssets      GeneratedAsset[]

  @@index([companyId, status])
  @@index([companyId, scheduledFor])
  /// Content Studio's board is `where companyId = ? order by updatedAt desc`,
  /// and no existing index covers that sort — so Postgres read every draft in
  /// the workspace and sorted them in memory on each page load. This one lets
  /// it walk the top N straight off the index.
  @@index([companyId, updatedAt])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Sprint 3 — Content Studio: knowledge base, campaigns
// ---------------------------------------------------------------------------

/// A tracked ingestion source (website/blog) with sync status. Uploads create
/// chunks directly and are summarized on the ingestion page from KnowledgeChunk.
model KnowledgeSource {
  id           String                @id @default(cuid())
  companyId    String
  type         KnowledgeSourceType
  /// What kind of business material this is. Null on sources ingested before
  /// categories existed, and on crawled pages where we have no basis to guess.
  category     MaterialCategory?
  url          String?
  label        String
  status       KnowledgeSourceStatus @default(PENDING)
  lastSyncedAt DateTime?
  error        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, url])
  @@index([companyId])

  @@index([companyId, createdAt])
}

/// A retrievable chunk of the company's own content, grounding AI generation.
model KnowledgeChunk {
  id         String              @id @default(cuid())
  companyId  String
  sourceType KnowledgeSourceType
  /// Denormalised from KnowledgeSource so retrieval can weight by material
  /// kind without a join on the hot path — retrieve() scans up to 400 rows.
  category   MaterialCategory?
  sourceUrl  String?
  title      String?
  content    String              @db.Text
  tokenCount Int?
  createdAt  DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sourceType])
}

/// Sprint 3 stub — Campaign Builder UI arrives in a later sprint. Content can
/// already be tagged to a campaign at generation time.
/// Sprint 6 — the Campaign Orchestrator ties every prior module into one
/// reviewable 30-day plan. `plan` holds the Zod-validated day-by-day plan; the
/// planner turns it into CampaignTask rows that TRIGGER the existing Sprint 3-5
/// pipelines (it never generates or publishes directly).
model Campaign {
  id              String         @id @default(cuid())
  companyId       String
  name            String
  goal            String?        @db.Text
  status          CampaignStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  durationDays    Int            @default(30)
  /// { content: bool, outreach: bool, engagement: bool, discovery: bool }.
  modulesIncluded Json           @default("{}")
  targetAudience  String?        @db.Text
  themes          String[]       @default([])
  /// The AI-generated day-by-day plan (validated by campaignPlanSchema).
  plan            Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drafts  ContentDraft[]
  tasks   CampaignTask[]

  @@index([companyId, status])

  @@index([companyId, createdAt])
}

/// Sprint 6 — one scheduled unit of campaign work. The daily cron finds due
/// PENDING tasks and triggers the matching existing pipeline (content generator,
/// outreach drafting, discovery run), landing output in the normal approval
/// queue. REVIEW_CHECKPOINT tasks hold an AI progress summary.
model CampaignTask {
  id                    String             @id @default(cuid())
  campaignId            String
  companyId             String
  scheduledDate         DateTime
  taskType              CampaignTaskType
  status                CampaignTaskStatus @default(PENDING)
  /// For GENERATE_CONTENT: which content type + the planned topic/angle.
  contentType           ContentType?
  topic                 String?            @db.Text
  rationale             String?            @db.Text
  /// Drill-through to the produced item in its normal queue.
  relatedContentDraftId String?
  relatedDiscoveryRunId String?
  /// For REVIEW_CHECKPOINT: the generated weekly progress summary.
  checkpointSummary     String?            @db.Text
  error                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, scheduledDate])
  @@index([campaignId, scheduledDate])
  @@index([status, scheduledDate])
}

/// Sprint 2 — daily trend intelligence digests per company.
/// `payload` holds the structured digest:
///   { items: [{ id, title, source, url, score, aiSummary, suggestedAngle }],
///     generatedAt, model, sources: {...counts} }
model TrendDigest {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Idempotency: one digest per company per calendar day (see NON-NEGOTIABLE #6).
  @@unique([companyId, date])
  @@index([companyId])

  @@index([companyId, date])
}

/// Sprint 2 — per-company Trend Intelligence configuration. 1:1 with Company.
/// String[] columns use native Postgres text[]. Smart defaults are seeded from
/// onboarding data (industry + brand voice) via a one-time Claude call, then
/// fully user-editable on /dashboard/settings/trends.
model CompanyTrendConfig {
  id              String   @id @default(cuid())
  companyId       String   @unique
  /// Topics/phrases relevant to the company's market.
  keywords        String[] @default([])
  /// Subreddits to monitor (names without the "r/" prefix).
  subreddits      String[] @default([])
  /// Additional RSS feed URLs to ingest alongside keyword-based Google News.
  rssFeeds        String[] @default([])
  /// Lightweight competitor watch list (names). The richer CompetitorProfile
  /// table (Sprint 5) is the system of record; this feeds trend mention checks.
  competitorNames String[] @default([])
  /// Which sources are enabled: { reddit, hackernews, news, twitter }.
  enabledSources  Json     @default("{\"reddit\":true,\"hackernews\":true,\"news\":true,\"twitter\":false}")
  // --- Geo & scope filters (AI Trend Insights) ---
  /// ISO country code for Google/Bing News locale (e.g. "US", "GB", "IN"). Null = global.
  geoCountry      String?
  /// Free-text region/state and city, appended to news queries as location hints.
  geoRegion       String?
  geoCity         String?
  /// UI language code for news locale (e.g. "en", "es", "fr"). Default English.
  language        String   @default("en")
  /// Only surface items newer than this many days (24h=1, 7d=7, 30d=30).
  timeRangeDays   Int      @default(4)
  /// True once smart defaults have been generated, so we don't overwrite edits.
  defaultsSeeded  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Sprint 4 — tracked competitor profiles per company. Signal is gathered ONLY
/// from legitimate public sources (website diff, public news/RSS, GitHub API).
/// The public LinkedIn Company Page feed is NOT read (no official API scope) —
/// see server/competitors/sources/linkedin.ts, which is a flagged stub.
model CompetitorProfile {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  /// Homepage / primary website URL (tracked for change detection).
  url             String?
  /// Optional pricing page URL (tracked separately from homepage).
  pricingUrl      String?
  /// Optional public LinkedIn Company Page URL (display + future API scope).
  linkedInUrl     String?
  /// Optional GitHub org/user login for public repo-activity signal.
  githubOrg       String?
  notes           String?  @db.Text
  /// When false, the tracking pipeline skips this competitor.
  trackingEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@index([companyId])

  @@index([companyId, createdAt])
}

/// Sprint 4 — a point-in-time capture of a competitor's public signal. Each run
/// hashes the homepage/pricing text and, when content changed vs the previous
/// snapshot, stores a Claude-written human-readable `changesSummary`.
model CompetitorSnapshot {
  id             String   @id @default(cuid())
  competitorId   String
  capturedAt     DateTime @default(now())
  /// SHA-256 of normalized homepage text (fast change detection).
  homepageHash   String?
  /// Extracted, normalized homepage text (bounded) for diffing/summary.
  homepageText   String?  @db.Text
  pricingHash    String?
  pricingText    String?  @db.Text
  /// Structured, human-readable diff:
  ///   { hasChanges, homepage?: string, pricing?: string, news: [...],
  ///     github?: {...}, model }
  changesSummary Json     @default("{}")
  createdAt      DateTime @default(now())

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
}

/// Sprint 4 — weekly aggregated competitor intelligence report per company.
/// `payload` holds the structured, Claude-generated digest:
///   { competitors: [{ competitor, newLaunches, pricingChanges,
///     notableActivity, strategicTakeaway }], synthesis, generatedAt, model }
model CompetitorReport {
  id          String   @id @default(cuid())
  companyId   String
  /// Monday 00:00 UTC of the ISO week the report covers (idempotency key).
  weekStart   DateTime
  weekEnd     DateTime
  payload     Json     @default("{}")
  model       String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStart])
  @@index([companyId, weekStart])
}

// ---------------------------------------------------------------------------
// Sprint 4 — Chrome Extension (the human action layer)
// ---------------------------------------------------------------------------

/// A revocable, per-user bearer token for the companion Chrome Extension.
/// SECURITY: we store ONLY sha256(rawToken) — the raw token lives only in the
/// extension's chrome.storage.local. This token authorizes ONLY the
/// /api/extension/* endpoints (queue read + action sync-back), never the full
/// web session. It is scoped to one workspace (companyId) and independently
/// revocable, so a compromised extension token cannot escalate to account
/// access. See server/extension/token.service.ts + lib/extension-auth.ts.
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  companyId  String
  /// Human label (e.g. browser/device) shown in settings.
  label      String?
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Sprint 4 — Outreach Intelligence
// ---------------------------------------------------------------------------

/// Per-company outreach targeting config (1:1 with Company). Mirrors
/// CompanyTrendConfig. Drives which public signal sources run and how leads are
/// filtered. String[] use native Postgres text[].
model OutreachConfig {
  id             String   @id @default(cuid())
  companyId      String   @unique
  /// Target industries/keywords the company sells into.
  industries     String[] @default([])
  /// Role titles worth reaching (e.g. "Head of Marketing").
  roleTitles     String[] @default([])
  /// Company size/stage filters (free-form tags, e.g. "seed", "50-200").
  companyStages  String[] @default([])
  /// Which signal sources are on: { crunchbase, github, jobs, news }.
  enabledSources Json     @default("{\"crunchbase\":false,\"github\":true,\"jobs\":true,\"news\":true}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// A potential outreach target. Sourced from public signal at COMPANY
/// granularity; a person's name/title/LinkedIn URL are added/confirmed by the
/// user (never scraped from LinkedIn).
model Lead {
  id                 String     @id @default(cuid())
  companyId          String
  /// Person name — optional until the user confirms it.
  name               String?
  title              String?
  /// The target organization the signal is about.
  companyName        String
  sourceUrl          String?
  /// Publicly-discoverable profile URL, manually confirmed by the user.
  linkedInProfileUrl String?
  status             LeadStatus @default(NEW)
  /// Sprint 5 — how this lead entered the system.
  source             LeadSource @default(SIGNAL)
  /// Sprint 5 — the DiscoveryProfile that found this lead (if discovered).
  discoveryProfileId String?
  /// Sprint 5 — AI fit score 0-100 against the discovery profile's criteria.
  fitScore           Int?
  /// Sprint 5 — short "why this lead" rationale (traceable, human-readable).
  fitRationale       String?    @db.Text
  /// Which stated criteria this lead meets / does not. A score with no
  /// breakdown cannot be reviewed, so the breakdown is stored beside it.
  fitMatched         String[]   @default([])
  fitMissed          String[]   @default([])
  /// Why a human judged this lead irrelevant. Feeds future discovery so the
  /// same bad matches stop being surfaced.
  irrelevantReason   String?    @db.Text
  irrelevantAt       DateTime?
  /// The requirement/category this lead came from, snapshotted at creation
  /// (e.g. "Distillery", "Liquor Store", "Head of Marketing"). Denormalized on
  /// purpose: leads must keep their origin even if the profile is renamed or
  /// deleted, so different requirements never get mixed together.
  category           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discoveryProfile DiscoveryProfile? @relation(fields: [discoveryProfileId], references: [id], onDelete: SetNull)
  signals          LeadSignal[]
  messages         OutreachMessage[]

  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, category])
  @@index([discoveryProfileId])

  @@index([companyId, updatedAt])
}

/// A detected public signal attached to a lead (funding, hiring, etc.).
model LeadSignal {
  id          String     @id @default(cuid())
  leadId      String
  signalType  SignalType
  description String     @db.Text
  sourceUrl   String?
  detectedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/// An AI-drafted outreach message pending human approval, then a human send via
/// the extension. Nothing reaches SENT without both.
model OutreachMessage {
  id                 String         @id @default(cuid())
  leadId             String
  companyId          String
  type               OutreachType
  status             OutreachStatus @default(DRAFT)
  draftText          String         @db.Text
  /// Generation context: { model, promptVersion, signalId, brandVoiceApplied }.
  aiMetadata         Json           @default("{}")
  rejectionReason    String?
  sentAt             DateTime?
  /// Sprint 5 — the "did it work" outcome signals, manually confirmed by the
  /// user (no API exposes these). Feed the Marketing Memory learning loop.
  connectionAccepted Boolean        @default(false)
  replyReceived      Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  lead                 Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performanceSnapshots PerformanceSnapshot[]

  @@index([companyId, status])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Sprint 5 — Lead Discovery Engine (proactive prospecting)
// ---------------------------------------------------------------------------

/// A saved, reusable search profile describing WHO the company wants to reach.
/// `criteria` is a structured JSON bag (industry, stage, roleTitles, geography,
/// keywords) validated by lib/validations/discovery.ts. A profile can auto-run
/// weekly (autoRun) via the discovery cron.
model DiscoveryProfile {
  id        String    @id @default(cuid())
  companyId String
  name      String
  /// Human category this requirement produces leads for (e.g. "Distillery",
  /// "Liquor Store", "Role: Head of Marketing"). Stamped onto every lead the
  /// profile discovers so leads stay grouped by where they came from.
  category  String?
  criteria  Json      @default("{}")
  isActive  Boolean   @default(true)
  autoRun   Boolean   @default(false)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    DiscoveryRun[]
  leads   Lead[]

  @@index([companyId])

  @@index([companyId, createdAt])
}

/// One execution of a DiscoveryProfile against the public sources — the run
/// history surfaced at /dashboard/leads. `summary` records per-source counts +
/// skipped sources (transparency), so a run with 0 results is honestly empty.
model DiscoveryRun {
  id                 String             @id @default(cuid())
  companyId          String
  discoveryProfileId String
  status             DiscoveryRunStatus @default(RUNNING)
  leadsFound         Int                @default(0)
  leadsCreated       Int                @default(0)
  summary            Json               @default("{}")
  startedAt          DateTime           @default(now())
  finishedAt         DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile DiscoveryProfile @relation(fields: [discoveryProfileId], references: [id], onDelete: Cascade)

  @@index([companyId, startedAt])
  @@index([discoveryProfileId])
}

// ---------------------------------------------------------------------------
// Sprint 4 — Engagement Copilot
// ---------------------------------------------------------------------------

/// A public LinkedIn profile/page the user chose to monitor for engagement.
/// Monitoring happens ENTIRELY in the extension (DOM already shown to the user);
/// the backend never fetches these feeds.
model EngagementTarget {
  id         String   @id @default(cuid())
  companyId  String
  label      String
  profileUrl String
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, profileUrl])
  @@index([companyId])

  @@index([companyId, createdAt])
}

/// An AI-drafted comment for a post the user was already viewing. The post text
/// is captured client-side by the extension and sent here to draft; the human
/// posts it with one click in the extension. The web app is the system of
/// record (read-only history at /dashboard/engagement).
model EngagementComment {
  id            String           @id @default(cuid())
  companyId     String
  createdById   String?
  targetPostUrl String
  targetAuthor  String?
  /// The visible post text the comment responds to (from the user's own DOM).
  postExcerpt   String?          @db.Text
  draftText     String           @db.Text
  status        EngagementStatus @default(DRAFT)
  aiMetadata    Json             @default("{}")
  postedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  performanceSnapshots PerformanceSnapshot[]

  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Sprint 5 — Marketing Memory / Learning Loop
// ---------------------------------------------------------------------------

/// A captured performance measurement for a published item. `metrics` is a
/// source-shaped JSON bag (e.g. { impressions, likes, comments, clicks }).
/// NON-NEGOTIABLE #2: we never fabricate — a snapshot only exists when a real
/// source (LinkedIn API, the extension's DOM read of the user's own post, or a
/// manual entry) provided numbers.
model PerformanceSnapshot {
  id                  String            @id @default(cuid())
  companyId           String
  contentDraftId      String?
  outreachMessageId   String?
  engagementCommentId String?
  source              PerformanceSource
  metrics             Json              @default("{}")
  capturedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentDraft      ContentDraft?      @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  outreachMessage   OutreachMessage?   @relation(fields: [outreachMessageId], references: [id], onDelete: Cascade)
  engagementComment EngagementComment? @relation(fields: [engagementCommentId], references: [id], onDelete: Cascade)

  @@index([companyId, capturedAt])
  @@index([contentDraftId])
}

/// A learned marketing insight extracted from real PerformanceSnapshot data.
/// NON-NEGOTIABLE #3: every insight references the data that supports it via
/// `supportingDataSummary`, and `confidence`/`sampleSize` are derived from how
/// much real data exists — never confident-sounding output from thin data.
model MarketingMemory {
  id                    String           @id @default(cuid())
  companyId             String
  insightType           InsightType
  insight               String           @db.Text
  confidence            MemoryConfidence @default(LOW)
  sampleSize            Int              @default(0)
  /// { basis: string, metric: string, itemIds: string[], ... } — traceable.
  supportingDataSummary Json             @default("{}")
  isActive              Boolean          @default(true)
  generatedAt           DateTime         @default(now())
  createdAt             DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, insightType])
  @@index([companyId, isActive])

  @@index([companyId, generatedAt])
}

// ---------------------------------------------------------------------------
// Sprint 6 — Billing (Stripe) + Analytics reports
// ---------------------------------------------------------------------------

/// One subscription per company (the tenant is billed, not the user). Stripe is
/// the source of truth for payment state; this mirrors it via signed webhooks.
/// `plan` drives entitlements (server/billing/entitlements.ts). Trial is tracked
/// with trialEndsAt so access degrades gracefully (never a data-losing lockout).
model Subscription {
  id                   String             @id @default(cuid())
  companyId            String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(TRIAL)
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

/// Sprint 6 — a stored, shareable weekly analytics report (Claude-written from
/// real numbers). Idempotent per company per period.
model AnalyticsReport {
  id          String   @id @default(cuid())
  companyId   String
  periodStart DateTime
  periodEnd   DateTime
  summary     String   @db.Text
  metrics     Json     @default("{}")
  generatedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodStart])
  @@index([companyId, periodStart])
}

// ---------------------------------------------------------------------------
// Client review Phase 2 — Connectors (real credential storage)
// ---------------------------------------------------------------------------

/// How a connector authenticates. OAUTH = three-legged flow (tokens stored
/// encrypted); API_KEY = the customer pastes a key we store encrypted.
enum ConnectionKind {
  OAUTH
  API_KEY
  /// Ownership of the account email proved with a one-time code. Used where a
  /// provider's OAuth app is not yet registered, so a workspace can still
  /// record which account a connector belongs to and start logging results.
  EMAIL_CODE
}

/// Lifecycle of a live connector connection.
enum ConnectionStatus {
  CONNECTED
  ERROR
  EXPIRED
  DISCONNECTED
}

/// A live connection between a company and an external tool. One row per
/// (company, connector). Secrets are ALWAYS stored encrypted at rest via
/// lib/crypto.ts — never in plaintext, never returned to the client.
model Connection {
  id              String           @id @default(cuid())
  companyId       String
  /// Registry id from lib/connectors.ts (e.g. "ga4", "hubspot", "crunchbase").
  connectorId     String
  kind            ConnectionKind
  status          ConnectionStatus @default(CONNECTED)
  /// Safe, non-secret display label (account email, property name, org).
  accountLabel    String?
  scope           String?
  accessTokenEnc  String?          @db.Text
  refreshTokenEnc String?          @db.Text
  apiKeyEnc       String?          @db.Text
  expiresAt       DateTime?
  /// Non-secret connector-specific settings (e.g. GA4 propertyId).
  metadata        Json             @default("{}")
  lastSyncedAt    DateTime?
  /// Populated when status = ERROR/EXPIRED so the UI can prompt a reconnect.
  errorMessage    String?          @db.Text
  connectedById   String?
  /// EMAIL_CODE only — the address a one-time code was sent to.
  verifiedEmail   String?
  verifiedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, connectorId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Client review Phase 2 — AI Marketing Advisor + AI Marketing Planner
// ---------------------------------------------------------------------------

/// A generated set of campaign opportunities, synthesized from real competitor
/// activity + trend signal + the company's own performance. Idempotent per day.
model AdvisorReport {
  id          String   @id @default(cuid())
  companyId   String
  /// Start of the UTC day this report belongs to (idempotency key).
  date        DateTime
  payload     Json     @default("{}")
  model       String   @default("none")
  generatedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
}

/// A monthly content calendar generated from an explicit brief (business goals,
/// campaign objectives, topics, brand guidelines). Idempotent per company/month
/// so regenerating replaces rather than duplicates.
model MarketingPlan {
  id          String   @id @default(cuid())
  companyId   String
  /// First day (UTC) of the plan month.
  month       DateTime
  /// The human brief this plan was generated from (goals/objectives/topics/…).
  inputs      Json     @default("{}")
  /// The generated calendar: { weeks[], items[], themes[], cadence, … }.
  payload     Json     @default("{}")
  model       String   @default("none")
  createdById String?
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month])
  @@index([companyId, month])
}

// ---------------------------------------------------------------------------
// Client review Phase 3 — AI Marketing Intelligence dashboard
// ---------------------------------------------------------------------------

/// A point-in-time computation of the unified marketing intelligence scores.
/// Stored so the dashboard loads instantly and can show movement over time;
/// every number is derived from real rows (never fabricated).
model IntelligenceSnapshot {
  id           String   @id @default(cuid())
  companyId    String
  /// Start of the UTC day (idempotency key — recompute replaces the day).
  date         DateTime
  /// Full computed payload (see server/intelligence/types.ts).
  payload      Json     @default("{}")
  /// Headline 0-100 score, denormalized for cheap trend queries.
  overallScore Int      @default(0)
  model        String   @default("none")
  generatedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
}

// ---------------------------------------------------------------------------
// Screens review — background generation jobs
// ---------------------------------------------------------------------------

/// What a GenerationJob produces. Each kind maps to one runner in
/// server/jobs/runners.ts.
enum GenerationJobKind {
  TREND_DIGEST
  MARKETING_PLAN
  INTELLIGENCE
  BRAND_VOICE_PREVIEW
  /// Graphic generation. Several variations on a slow provider comfortably
  /// exceed a serverless function budget run inline, which is exactly the
  /// failure this queue exists to prevent.
  IMAGE_GENERATION
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// A long AI generation, moved off the request thread.
///
/// The trend digest, the monthly calendar and the intelligence run all fan out
/// to several sources and make multiple model calls. Run inline they exceeded
/// the platform's function budget and were killed mid-flight, which the UI
/// could only report as a hang or a generic failure. Here the work is a row:
/// the request creates it and returns immediately, a runner advances it, and
/// the client polls `progress` for a real status line.
///
/// `inputs` is retained for the lifetime of the job so a failed run can be
/// retried without the user re-entering their brief.
model GenerationJob {
  id         String              @id @default(cuid())
  companyId  String
  userId     String?
  kind       GenerationJobKind
  status     GenerationJobStatus @default(QUEUED)
  /// The request that produced this job — replayed verbatim on retry.
  inputs     Json                @default("{}")
  /// { step, message, percent } — what the UI shows while it runs.
  progress   Json                @default("{}")
  /// Kind-specific result summary once SUCCEEDED.
  result     Json                @default("{}")
  /// Human-readable failure reason, shown directly to the user.
  error      String?             @db.Text
  attempts   Int                 @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The reaper scans by status+age; the UI lists a company's recent jobs.
  @@index([companyId, kind, status])
  @@index([status, createdAt])
}

/// A one-time code proving the recipient controls an email address.
///
/// Backs the "connect with an email and verification code" path: the code is
/// stored hashed (never in the clear), single-use, short-lived, and rate-limited
/// by attempt count — the same handling as a password reset token, because it
/// grants the same kind of access.
model ConnectorEmailVerification {
  id          String    @id @default(cuid())
  companyId   String
  connectorId String
  email       String
  /// SHA-256 of the 6-digit code. Never store the code itself.
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId, connectorId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Graphic Generation — generated visuals + the post media attachment layer
// ---------------------------------------------------------------------------

/// A graphic produced by an image-generation provider.
///
/// Provider image URLs expire (OpenAI's within the hour, Replicate's within the
/// day), so a post scheduled for next Tuesday cannot depend on one. The bytes
/// are fetched once at generation time and stored — in this row by default, or
/// in an S3-compatible bucket when one is configured. `sourceUrl` is kept only
/// so a generation stays traceable back to the provider response.
///
/// Both prompts are retained on purpose: `originalPrompt` is what the content
/// analysis produced, `prompt` is what the user actually sent after editing it,
/// and `revisedPrompt` is the provider's own rewrite where it reports one. That
/// is what makes "why did it draw that?" answerable later.
model GeneratedAsset {
  id             String           @id @default(cuid())
  companyId      String
  /// The draft this was generated for. SetNull rather than Cascade: deleting a
  /// draft must not silently destroy a graphic the user reused elsewhere.
  contentDraftId String?
  createdById    String?
  provider       ImageProvider
  /// Provider-specific model id, recorded verbatim (e.g. "gpt-image-1").
  model          String
  kind           MediaKind        @default(IMAGE)
  /// The exact prompt sent to the provider.
  prompt         String           @db.Text
  /// The AI-written prompt before any human edit.
  originalPrompt String?          @db.Text
  /// The provider's own rewritten prompt, when it returns one.
  revisedPrompt  String?          @db.Text
  negativePrompt String?          @db.Text
  style          String?
  aspectRatio    String
  width          Int
  height         Int
  mimeType       String
  fileSize       Int
  storage        AssetStorageKind @default(DATABASE)
  /// DATABASE storage — the image itself.
  data           Bytes?
  /// EXTERNAL storage — the durable URL in our own bucket.
  storageUrl     String?
  /// The provider's original (expiring) URL. Never relied on for publishing.
  sourceUrl      String?
  /// Which platform the generation was framed for (drives size + art direction).
  platform       SocialPlatform?
  /// { seed, providerRequestId, safety, ... } — provider-shaped extras.
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentDraft ContentDraft?  @relation(fields: [contentDraftId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attachments  ContentMedia[]

  /// The history view: this company's graphics, newest first.
  @@index([companyId, createdAt])
  @@index([contentDraftId, createdAt])
}

/// The generic media attachment layer: a post has ordered media, and any asset
/// can hang off more than one post (that is what "reuse this graphic" means).
///
/// Kept as a join rather than a column on ContentDraft so carousels — several
/// images in a defined order — need no further schema work, and so an asset's
/// generation history stays independent of where it ended up being used.
model ContentMedia {
  id             String    @id @default(cuid())
  companyId      String
  contentDraftId String
  assetId        String
  kind           MediaKind @default(IMAGE)
  /// Order within the post's media set (0 = the first/only image).
  position       Int       @default(0)
  /// Accessibility text sent to platforms that accept it (LinkedIn, Instagram).
  altText        String?
  createdAt      DateTime  @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentDraft ContentDraft   @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  asset        GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Attaching the same graphic twice to one post is a no-op, not a duplicate.
  @@unique([contentDraftId, assetId])
  @@index([contentDraftId, position])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Autonomous agent — the weekly briefing
// ---------------------------------------------------------------------------

/// Lifecycle of a weekly briefing.
enum BriefingStatus {
  /// The autonomous cycle is still producing this week's work.
  WORKING
  /// Assembled and ready to read.
  READY
  /// The cycle failed outright. `error` explains it; the UI never shows a
  /// half-built briefing as if it were finished.
  FAILED
}

/// What Aura did for a workspace this week, as one artifact.
///
/// This is the difference between "a dashboard with twelve AI tools" and "an AI
/// marketing employee". Every input already existed — trend digests, competitor
/// reports, advisor opportunities, intelligence scores, marketing memory,
/// content drafts. What did not exist was anything that ASSEMBLED them into a
/// single thing a person could open on Monday morning and act on.
///
/// `payload` is the assembled briefing, validated by lib/validations/briefing.ts.
/// It is a snapshot on purpose: it records what was true that week, so a
/// briefing read later still reflects the week it describes rather than
/// silently re-rendering against today's data.
model WorkspaceBriefing {
  id        String         @id @default(cuid())
  companyId String
  /// Monday 00:00 UTC of the week this covers — the idempotency key, matching
  /// how CompetitorReport already keys its weeks.
  weekStart DateTime
  weekEnd   DateTime
  status    BriefingStatus @default(WORKING)
  /// The assembled briefing (see briefingPayloadSchema).
  payload   Json           @default("{}")
  /// What the autonomous cycle actually did this week: drafts written,
  /// graphics generated, what it skipped and why. Kept separate from `payload`
  /// so the record of the agent's own actions survives a payload reshape.
  activity  Json           @default("{}")
  /// Human-readable failure reason when status = FAILED.
  error     String?        @db.Text
  model     String         @default("none")

  generatedAt DateTime  @default(now())
  /// When the human last opened it — drives the "new since you were away" mark.
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// One briefing per company per week; a re-run replaces rather than duplicates.
  @@unique([companyId, weekStart])
  @@index([companyId, weekStart])
}

// ---------------------------------------------------------------------------
// Business Context Snapshot
// ---------------------------------------------------------------------------

/// The latest AI-ready snapshot of a workspace's business context (see
/// server/business-context/snapshot.service.ts). One row per company, rebuilt
/// when its sources change, when it ages past its TTL, or on demand.
///
/// `sourceStamp` is a hash of the version of every table the snapshot reads,
/// taken at build time; comparing it with a fresh stamp is how a reader knows
/// the snapshot is current without rebuilding it. `fingerprint` hashes the
/// snapshot content itself, so an AI output can record exactly which business
/// context it was produced from.
model BusinessContextSnapshot {
  id            String    @id @default(cuid())
  companyId     String    @unique
  /// Snapshot format version; a mismatch forces a rebuild after a deploy.
  version       Int
  fingerprint   String
  sourceStamp   String
  payload       Json
  generatedAt   DateTime  @default(now())
  /// Set by writers whose changes the source stamp cannot see (e.g. editing a
  /// memory insight's text). The next read rebuilds.
  invalidatedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Lifecycle of a question Aura asks about missing business information.
enum ContextQuestionStatus {
  OPEN
  ANSWERED
  SNOOZED
  DISMISSED
  RESOLVED
}

/// One question Aura has asked (or will ask) about the business — see
/// server/business-context/questions.service.ts. The questions themselves are
/// derived from the Business Context each time; this row only remembers what
/// happened to each one, so Aura does not ask the same thing over and over.
///
/// `questionKey` is `<kind>:<field>` (e.g. `missing:audience.stated`), so a
/// different problem with the same field is a different question.
model BusinessContextQuestion {
  id           String                @id @default(cuid())
  companyId    String
  questionKey  String
  status       ContextQuestionStatus @default(OPEN)
  /// Times it was shown, counting at most once per cooldown window.
  timesAsked   Int                   @default(0)
  lastAskedAt  DateTime?
  snoozedUntil DateTime?
  answeredAt   DateTime?
  answeredById String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, questionKey])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

/// What kind of opening an opportunity is.
enum OpportunityType {
  TRENDING_TOPIC
  COMPETITOR_MOVE
  COMPETITIVE_GAP
  CONTENT_GAP
  SEASONAL_MOMENT
  AUDIENCE_SEGMENT
  CHANNEL
  PERFORMANCE_PATTERN
  OTHER
}

/// Lifecycle: DETECTED → REVIEWED → RECOMMENDED → ACCEPTED / REJECTED,
/// with EXPIRED when its relevance window passes first. See lib/opportunities.ts.
enum OpportunityStatus {
  DETECTED
  REVIEWED
  RECOMMENDED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityConfidence {
  LOW
  MEDIUM
  HIGH
}

/// Which part of Aura detected it.
enum OpportunitySource {
  ADVISOR
  TRENDS
  COMPETITORS
  MEMORY
  ANALYTICS
  /// Detected from the business's own context (e.g. an unconnected channel).
  BUSINESS_CONTEXT
  /// Interpreted by AI detection and validated against its evidence.
  AI_DETECTION
  MANUAL
}

/// What kind of record a piece of evidence points at.
enum OpportunitySignalKind {
  COMPETITOR_SNAPSHOT
  TREND_ITEM
  MEMORY_INSIGHT
  CONTENT_DRAFT
  ANALYTICS_REPORT
  KNOWLEDGE_CHUNK
  LEAD_SIGNAL
  BUSINESS_CONTEXT
  EXTERNAL
}

/// An opportunity Aura detected, stored on its own so it can be reviewed,
/// tracked and later recommended. Recommendations point here with
/// `opportunityId`; an opportunity never depends on one existing.
model Opportunity {
  id               String                @id @default(cuid())
  companyId        String
  type             OpportunityType
  status           OpportunityStatus     @default(DETECTED)
  title            String
  summary          String                @db.Text
  /// Why it is worth doing now.
  rationale        String?               @db.Text
  /// How to approach it differently from competitors.
  angle            String?               @db.Text
  /// Channels, content ideas, effort/impact — what acting on it looks like.
  details          Json                  @default("{}")
  source           OpportunitySource
  /// The model or rule that produced it, e.g. "claude-…" or "deterministic".
  detectedBy       String
  priority         OpportunityPriority
  /// 0–100, for ordering within a priority.
  priorityScore    Int
  confidence       OpportunityConfidence
  /// Why the confidence is what it is.
  confidenceReason String?
  /// How much it would matter and cost ("low" | "medium" | "high"), as the
  /// detector judged it. Kept so a recommendation can start from them; null
  /// on opportunities stored before they were recorded.
  impact           String?
  effort           String?
  /// Same key = same opportunity: re-detection updates instead of duplicating.
  dedupeKey        String
  detectedAt       DateTime              @default(now())
  /// Last time a detector saw it again.
  lastSeenAt       DateTime              @default(now())
  /// After this it is no longer worth acting on; null = no natural expiry.
  relevantUntil    DateTime?
  statusChangedAt  DateTime              @default(now())
  reviewedAt       DateTime?
  recommendedAt    DateTime?
  decidedAt        DateTime?
  decidedById      String?
  decisionNote     String?               @db.Text
  expiredAt        DateTime?
  /// The Business Context it was detected against: Company revision, snapshot
  /// fingerprint, and the context fields it relies on.
  contextRevision  String?
  contextFingerprint String?
  contextFields    String[]              @default([])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signals         OpportunitySignal[]
  events          OpportunityEvent[]
  recommendations Recommendation[]

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([companyId, relevantUntil])
}

/// One piece of evidence for an opportunity, linked to the record it came
/// from. `refId` is the id in that record's table (a trend item is
/// "<digestId>:<itemId>"); `fingerprint` stops the same evidence being added
/// twice when an opportunity is detected again.
model OpportunitySignal {
  id            String                @id @default(cuid())
  opportunityId String
  kind          OpportunitySignalKind
  refId         String?
  label         String
  detail        String                @db.Text
  url           String?
  observedAt    DateTime?
  fingerprint   String
  /// The normalised Signal this evidence came from, when it came through the
  /// signal aggregation layer. Kept if the signal is later pruned.
  signalId      String?
  createdAt     DateTime              @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  signal      Signal?     @relation(fields: [signalId], references: [id], onDelete: SetNull)
  recommendationEvidence RecommendationEvidence[]

  @@unique([opportunityId, fingerprint])
  @@index([kind, refId])
  @@index([signalId])
}

/// The lifecycle history: every status change, who made it and why.
model OpportunityEvent {
  id            String             @id @default(cuid())
  opportunityId String
  fromStatus    OpportunityStatus?
  toStatus      OpportunityStatus
  actorId       String?
  note          String?            @db.Text
  createdAt     DateTime           @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
}

// ---------------------------------------------------------------------------
// Signals
// ---------------------------------------------------------------------------

/// Which part of Aura a signal came from.
enum SignalSource {
  TRENDS
  COMPETITORS
  ANALYTICS
  MEMORY
  BUSINESS_CONTEXT
}

/// How far a signal can be relied on (see lib/signals.ts for the rules).
enum SignalReliability {
  LOW
  MEDIUM
  HIGH
}

/// One normalised observation from any Aura source, gathered in one place for
/// opportunity detection (server/signals/signal.service.ts).
///
/// `dedupeKey` makes the same observation one row however many times and from
/// however many records it is seen; `sightings` keeps the distinct records it
/// was seen in, which is what corroboration (and reliability) is counted from.
model Signal {
  id                String            @id @default(cuid())
  companyId         String
  source            SignalSource
  /// The kind of underlying record — shared with opportunity evidence.
  kind              OpportunitySignalKind
  title             String
  summary           String            @db.Text
  url               String?
  /// The record it was first seen in (a trend item is "<digestId>:<itemId>").
  refId             String?
  /// Every distinct record it has been seen in, capped.
  sightings         String[]          @default([])
  occurrences       Int               @default(1)
  /// When the thing itself happened or was published.
  observedAt        DateTime
  firstSeenAt       DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())
  /// After this it is no longer current; null = no natural expiry.
  expiresAt         DateTime?
  reliability       SignalReliability
  reliabilityReason String
  /// Source-specific magnitude (trend score, sample size, % change), if any.
  strength          Float?
  /// Business Context revision when it was last collected, and which parts
  /// of the business it relates to ("keyword:pricing", "competitor:Acme").
  contextRevision   String?
  contextMatches    String[]          @default([])
  /// Source-specific detail (trend source and suggested angle, metric values…).
  metadata          Json              @default("{}")
  dedupeKey         String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunitySignals OpportunitySignal[]
  recommendationEvidence RecommendationEvidence[]

  @@unique([companyId, dedupeKey])
  @@index([companyId, source, observedAt])
  @@index([companyId, lastSeenAt])
}

// ---------------------------------------------------------------------------
// Recommendations (foundation — the engine that writes them is Sprint 8)
// ---------------------------------------------------------------------------

/// Where a recommendation stands (lib/recommendations.ts LIFECYCLE).
///   PROPOSED ─► ACCEPTED ─► IN_PROGRESS ─► COMPLETED
///      │           └──────────────────────► COMPLETED
///      ├─► REJECTED      ├─► WITHDRAWN (taken back, or replaced)
///      └─► EXPIRED  (its relevance window passed before a decision)
/// Decisions are kept in step with the opportunity: accepting or rejecting a
/// recommendation accepts or rejects its opportunity, and vice versa.
enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  /// Replaced by a newer recommendation, or taken back before it was done.
  WITHDRAWN
  EXPIRED
}

/// What kind of action it recommends — decides which workflow carries it out.
enum RecommendationType {
  /// Create a piece of content (post, article, carousel…).
  CONTENT
  /// Several coordinated pieces over a period.
  CAMPAIGN
  /// Answer a competitor's move or theme.
  COMPETITIVE_RESPONSE
  /// Reach a group of people the business is not addressing.
  AUDIENCE
  /// Start, connect or change a channel.
  CHANNEL
  /// Do more of what works, or fix what stopped working.
  OPTIMIZATION
  OTHER
}

/// Something Aura recommends the business do, built from an opportunity
/// (docs/RECOMMENDATION-MODEL.md):
///
///   Opportunity · What · Why · Action · Expected outcome · Evidence ·
///   Confidence · Priority · Channel · Audience · Status
///
/// Stored on its own, with its own copy of the evidence and of the hand-off it
/// was built from, so it stays explainable whatever later happens to the
/// opportunity — which cannot be deleted while it has recommendations.
model Recommendation {
  id               String                @id @default(cuid())
  companyId        String
  /// The opportunity it answers. Required: there is no recommendation
  /// without an opportunity behind it.
  opportunityId    String
  type             RecommendationType
  status           RecommendationStatus  @default(PROPOSED)

  /// WHAT — a short headline and a sentence or two.
  title            String
  summary          String                @db.Text
  /// ACTION — the one thing to do, in the imperative, and optional steps.
  action           String                @db.Text
  steps            String[]              @default([])
  /// WHY — why this is worth doing now, from the evidence.
  rationale        String                @db.Text
  /// EXPECTED OUTCOME — what should change if it works, and how to tell.
  expectedOutcome  String                @db.Text
  outcomeMetric    String?
  /// CHANNEL — where to do it (lib/validations/planner.ts CONTENT_CHANNELS),
  /// and the content format when it is a content recommendation.
  channel          String?
  contentType      String?
  /// AUDIENCE — who it is for, where that applies.
  audience         String?               @db.Text
  /// Type-specific detail for the workflow that carries it out.
  details          Json                  @default("{}")

  /// GUARDRAILS (lib/recommendation-rules.ts). Whether it may be handed to an
  /// execution workflow; why not, if not; and what it rests on that is
  /// uncertain or what it conflicts with. Blocked ones are advice, not tasks.
  executable       Boolean               @default(true)
  blockers         String[]              @default([])
  flags            String[]              @default([])

  /// CONFIDENCE and PRIORITY — as handed over by the opportunity, or lower.
  confidence       OpportunityConfidence
  confidenceReason String?
  priority         OpportunityPriority
  priorityScore    Int

  /// RELEVANCE — not worth starting after this; null = no natural expiry.
  relevantUntil    DateTime?

  /// The opportunity hand-off it was built from (lib/recommendation-handoff.ts).
  handoff          Json
  handoffVersion   Int
  /// The Business Context it was built against.
  contextRevision    String?
  contextFingerprint String?
  contextFields      String[]            @default([])

  /// Who or what created it: "user:<id>", "rule:…", or a model name.
  createdBy        String
  statusChangedAt  DateTime              @default(now())
  decidedAt        DateTime?
  decidedById      String?
  decisionNote     String?               @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  expiredAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// NoAction: an opportunity with recommendations cannot be deleted on its
  /// own; deleting the whole workspace still removes both together.
  opportunity Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: NoAction)
  evidence    RecommendationEvidence[]
  events      RecommendationEvent[]

  @@index([companyId, status])
  @@index([companyId, relevantUntil])
  @@index([opportunityId])
}

/// One status change of a recommendation: who, when, from what, and why.
model RecommendationEvent {
  id               String                @id @default(cuid())
  recommendationId String
  fromStatus       RecommendationStatus?
  toStatus         RecommendationStatus
  actorId          String?
  note             String?               @db.Text
  createdAt        DateTime              @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId, createdAt])
}

/// Evidence carried forward from the opportunity, copied rather than shared:
/// the recommendation keeps what it was based on even if the opportunity
/// gains or loses evidence later. Links back to both the opportunity's
/// evidence row and the normalised signal, where they still exist.
model RecommendationEvidence {
  id                  String                @id @default(cuid())
  recommendationId    String
  opportunitySignalId String?
  signalId            String?
  kind                OpportunitySignalKind
  refId               String?
  label               String
  detail              String                @db.Text
  url                 String?
  observedAt          DateTime?
  /// Reliability of the normalised signal when it was carried forward.
  reliability         SignalReliability?
  createdAt           DateTime              @default(now())

  recommendation     Recommendation     @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  opportunitySignal  OpportunitySignal? @relation(fields: [opportunitySignalId], references: [id], onDelete: SetNull)
  signal             Signal?            @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([recommendationId])
  @@index([signalId])
}
