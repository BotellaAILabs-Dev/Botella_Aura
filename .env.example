# ==========================================================================
# Botella Aura — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---- Database (PostgreSQL) ------------------------------------------------
# Local dev example: postgresql://postgres:postgres@localhost:5432/botella_aura
# Use a pooled connection string in production (e.g. Supabase/Neon pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/botella_aura?schema=public"

# Direct (non-pooled) connection, used ONLY by `prisma migrate`.
# - Locally: set it to the same value as DATABASE_URL.
# - On Neon/Supabase: DATABASE_URL = the POOLED string, DIRECT_URL = the DIRECT
#   string. Migrations fail through a pooler (PgBouncer breaks advisory locks).
# If your provider gives only one URL, set both to that same URL — always safe.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/botella_aura?schema=public"

# ---- NextAuth -------------------------------------------------------------
# The canonical URL of your app. In prod set to https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"
# Secret used to encrypt JWTs / session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# ---- Google OAuth ---------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Application encryption key -------------------------------------------
# AES-256-GCM key used to encrypt sensitive tokens at rest (e.g. the
# LinkedIn access/refresh tokens scaffolded for Sprint 2).
# MUST be 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# ==========================================================================
# ---- Sprint 2 — LinkedIn + Trend Intelligence ----------------------------
# ==========================================================================

# ---- Anthropic (Claude) — powers trend digest AI -------------------------
# Create a key at https://console.anthropic.com  → API Keys.
# Without this, digests fall back to a non-AI summary (clearly labeled).
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL="claude-opus-4-8"

# ---- LinkedIn OAuth (Sprint 2 — official API only, NEVER scraping) -------
# Create an app at https://www.linkedin.com/developers/apps (needs a Company
# Page). Add the product "Sign In with LinkedIn using OpenID Connect".
# Add this exact Authorized redirect URL in the app's Auth tab:
#   http://localhost:3000/api/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Sprint 3 — Company Page auto-publish (PENDING LinkedIn Community Management
# API approval). Set the organization URN you administer, e.g.
# "urn:li:organization:12345678". Until this + the w_organization_social scope
# exist, Content Studio uses the "copy for manual posting" fallback.
# LINKEDIN_ORG_URN=""

# ---- Reddit API (Sprint 2 — trend source, read-only app-only token) ------
# Create an app at https://www.reddit.com/prefs/apps → type "script"/"web app".
# USER_AGENT is required by Reddit's API rules; identify your app + a contact.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="botella-aura/0.1 (by u/your-reddit-username)"

# ---- X / Twitter (Sprint 2 — OPTIONAL trend source) ----------------------
# Feature-flagged OFF unless a bearer token is present. No scraping.
# TWITTER_BEARER_TOKEN=""

# ---- Cron protection (Sprint 2 — scheduled digest job) -------------------
# Shared secret required to call POST /api/cron/trends. Generate with:
#   openssl rand -base64 32
CRON_SECRET=""

# Hacker News (Firebase API) and Google News (RSS) need NO credentials.
# The same CRON_SECRET also protects the Sprint 4 jobs:
#   POST /api/cron/competitors  (weekly competitor tracking + report)
#   POST /api/cron/outreach     (daily lead-signal detection)

# ==========================================================================
# ---- Sprint 4 (Competitors, Extension, Outreach, Engagement) -------------
# ==========================================================================

# ---- GitHub API (OPTIONAL) — competitor + outreach public-activity source -
# Works unauthenticated (60 req/hr). A token raises the limit to 5000/hr and is
# recommended if you track several competitors / run detection often.
# Create a fine-grained or classic token (no scopes needed for public data) at
# https://github.com/settings/tokens
# GITHUB_TOKEN=""

# ---- Crunchbase API (OPTIONAL) — outreach funding signals ----------------
# Paid/gated. When unset, the Crunchbase source is skipped (clearly flagged in
# the UI); GitHub + news + hiring RSS still run. No data is ever fabricated.
# CRUNCHBASE_API_KEY=""

# ---- Chrome extension origin (OPTIONAL, production) ----------------------
# The /api/extension/* routes are bearer-authenticated (no cookies), so CORS
# allows any chrome-extension:// origin by default (fine for unpacked dev, which
# gets a random id each load). For a PUBLISHED extension, pin its exact origin:
# EXTENSION_ALLOWED_ORIGIN="chrome-extension://<your-published-extension-id>"

# ==========================================================================
# ---- Sprint 5 (Lead Discovery + Marketing Memory) ------------------------
# ==========================================================================

# ---- Google Custom Search (OPTIONAL) — Lead Discovery web lookups --------
# Uses the OFFICIAL Custom Search JSON API (never scraping Google results).
# Both are required together; when unset, the Google source is skipped + flagged.
#   API key:            https://developers.google.com/custom-search/v1/overview
#   Search engine (CX): https://programmablesearchengine.google.com/  (create one,
#                       set it to "Search the entire web")
# GOOGLE_CSE_API_KEY=""
# GOOGLE_CSE_CX=""

# Lead Discovery also uses GITHUB_TOKEN (above) and CRUNCHBASE_API_KEY (above),
# both optional; the GitHub + company-website sources run without any key.
#
# The same CRON_SECRET protects the new Sprint 5 jobs:
#   POST /api/cron/discovery  (weekly auto-run of DiscoveryProfiles)
#   POST /api/cron/memory     (weekly Marketing Memory pattern extraction)
#
# Marketing Memory needs NO new keys. LinkedIn post analytics are unavailable at
# our current API scope — the extension syncs real metrics from the user's own
# post DOM instead; metrics are never fabricated.

# ==========================================================================
# ---- Sprint 6 (Billing + monitoring) -------------------------------------
# ==========================================================================

# ---- Stripe billing (OPTIONAL) — subscriptions -----------------------------
# Without these, /dashboard/settings/billing shows an honest "not configured"
# state and everyone runs on the implicit trial. To enable:
#   1. Create 3 recurring Products/Prices in the Stripe dashboard.
#   2. Put the price IDs below (change a price in Stripe — no redeploy needed).
#   3. Add a webhook endpoint -> https://your-domain.com/api/webhooks/stripe and
#      copy its signing secret to STRIPE_WEBHOOK_SECRET (signature is verified).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_GROWTH="price_..."
# STRIPE_PRICE_AGENCY="price_..."

# ---- Error monitoring (OPTIONAL) -------------------------------------------
# When set, lib/monitoring.ts ships captured exceptions to Sentry (best-effort);
# otherwise errors are structured-logged. Swap in @sentry/nextjs later if wanted.
# SENTRY_DSN=""

# ==========================================================================
# ---- Later-sprint placeholders (documented early) ------------------------
# ==========================================================================

# ---- Transactional email (password reset / invites) ----------------------
# REQUIRED for invitations to actually reach an inbox.
#
# With none of these set, lib/email.ts writes messages to the server log and the
# UI says so explicitly ("Email not sent") rather than reporting a false
# success — the team page then offers a copyable invite link instead. Verify
# your setup in-product at Settings -> Email delivery -> "Send test email to me".
#
# Option A - Resend (fastest):
# RESEND_API_KEY=""
# EMAIL_FROM="Botella Aura <no-reply@botella.ai>"   # must be a verified domain
#
# Option B - any SMTP provider (Gmail app password, SES, Mailgun, Zoho, 365):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"                                # "true" for port 465
# EMAIL_FROM="Botella Aura <no-reply@botella.ai>"

# ---- Public app URL (links inside emails) --------------------------------
# Falls back to NEXTAUTH_URL, then the platform's own URL (Vercel/Netlify), then
# the incoming request's Host header. Set it explicitly if invite links come out
# pointing at localhost.
# APP_URL="https://your-domain.com"

# ==========================================================================
# ---- Connectors (client review, Phase 2) ---------------------------------
# ==========================================================================
# Each OAuth connector needs a one-time app registration with the provider.
# Until its two variables are set, /dashboard/connectors shows the connector as
# "Needs setup" and names exactly which variables are missing, instead of an
# indefinite "Coming soon".
#
# Redirect URI to register with every provider below:
#   https://your-domain.com/api/connectors/<connector-id>/callback
#
# Google (powers both GA4 and Search Console connectors):
#   redirect URIs: .../api/connectors/ga4/callback
#                  .../api/connectors/search-console/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
#
# HubSpot - redirect URI: .../api/connectors/hubspot/callback
# HUBSPOT_CLIENT_ID=""
# HUBSPOT_CLIENT_SECRET=""
#
# Mailchimp - redirect URI: .../api/connectors/mailchimp/callback
# MAILCHIMP_CLIENT_ID=""
# MAILCHIMP_CLIENT_SECRET=""
#
# Slack - redirect URI: .../api/connectors/slack/callback
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
#
# API-key connectors (Crunchbase, Google Custom Search, GitHub) need NO env vars:
# each workspace pastes its own key at /dashboard/connectors, and it is verified
# against the provider before being stored encrypted. The CRUNCHBASE_API_KEY /
# GOOGLE_CSE_* / GITHUB_TOKEN variables above still work as a deployment-wide
# fallback for every workspace.
#
# NOTE: connector secrets are encrypted with ENCRYPTION_KEY. That variable is
# required for connectors to work at all.

# ==========================================================================
# ---- Scheduled jobs added by the client review ---------------------------
# ==========================================================================
# Protected by the same CRON_SECRET as every other job:
#   POST /api/cron/intelligence   daily   AI Marketing Intelligence snapshot
#   POST /api/cron/advisor        weekly  AI Marketing Advisor opportunities

# ==========================================================================
# ---- Scheduled jobs added by the screens review --------------------------
# ==========================================================================
# Protected by the same CRON_SECRET as every other job:
#   POST /api/cron/jobs           every 5m  background generation queue
#
# /api/cron/jobs is the safety net under long AI generations (trend digest,
# monthly calendar, intelligence run). Those now execute as background jobs so
# the request the user is waiting on returns immediately. This sweep restarts
# any job whose serverless instance was killed mid-flight, and picks up any
# whose browser-side kick never arrived. Without it, an interrupted run stays
# QUEUED forever and the UI shows a spinner that never resolves.

# ==========================================================================
# ---- Graphic Generation (Content Studio → Generate graphic) --------------
# ==========================================================================
# Content Studio can analyse a generated post, write an image prompt from it,
# and produce a graphic. Providers are pluggable: set the key for whichever
# one(s) you want available. Unconfigured providers are shown in the model
# selector as "not configured" with the variable to add — never hidden, never
# offered and then failing mid-generation.
#
# At least ONE of these is required for graphic generation to work at all.
# The prompt WRITING step reuses ANTHROPIC_API_KEY / GEMINI_API_KEY above; with
# neither, prompts fall back to a deterministic composer that is clearly
# labelled as such in the UI.

# ---- OpenAI Images (gpt-image-1) -----------------------------------------
# https://platform.openai.com/api-keys
# Formats: 1:1, 4:5, 16:9 (9:16 is substituted to the nearest supported).
OPENAI_API_KEY=""
# Optional model override.
# OPENAI_IMAGE_MODEL="gpt-image-1"

# ---- Google (Gemini / Imagen) --------------------------------------------
# https://aistudio.google.com/apikey
# Formats: 1:1, 4:5, 16:9, 9:16 (all native).
# GEMINI_API_KEY above also works — this is the same credential.
GOOGLE_AI_API_KEY=""
#
# Optional model override. LEAVE THIS UNSET unless you know your key can reach
# the model you name.
#
# Google serves image generation through two different APIs, and which one a
# key can see depends on how it was provisioned. A standard AI Studio key
# reaches the gemini-*-image family and CANNOT see any Imagen model — setting
# an imagen-* name on such a key makes every generation fail with HTTP 404,
# which reads like a broken deployment rather than a model you never had.
#
# This line previously suggested "imagen-4.0-generate-001", which is exactly
# the value that produces that failure on a normal key. The default the code
# uses (gemini-2.5-flash-image) works on an ordinary AI Studio key.
#
# GOOGLE_IMAGE_MODEL="gemini-2.5-flash-image"

# ---- Stability AI (Stable Image Core) ------------------------------------
# https://platform.stability.ai/account/keys
# Supports negative prompts. One image per API call (variations fan out).
STABILITY_API_KEY=""
# STABILITY_IMAGE_MODEL="stable-image-core"

# ---- Replicate -----------------------------------------------------------
# https://replicate.com/account/api-tokens
# The escape hatch: point REPLICATE_IMAGE_MODEL at ANY hosted model whose input
# takes `prompt` and `aspect_ratio` and it works with no code change.
REPLICATE_API_TOKEN=""
# REPLICATE_IMAGE_MODEL="black-forest-labs/flux-1.1-pro"

# ---- Generated-image storage (OPTIONAL) ----------------------------------
# By DEFAULT, generated images are stored in Postgres and served through an
# authenticated route. That needs no infrastructure and is the right choice for
# most deployments — provider image URLs expire within hours, so a post
# scheduled for next week cannot depend on one.
#
# To store images in an S3-compatible bucket instead (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO), set ALL FOUR of the variables below. Images generated
# before the switch keep working — each asset records where its bytes live.
# ASSET_S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# ASSET_S3_BUCKET="botella-aura-graphics"
# ASSET_S3_ACCESS_KEY_ID=""
# ASSET_S3_SECRET_ACCESS_KEY=""
# Region: "auto" for R2, e.g. "us-east-1" for AWS.
# ASSET_S3_REGION="auto"
# Public read URL, if the bucket is fronted by a CDN or custom domain.
# ASSET_S3_PUBLIC_BASE_URL="https://cdn.your-domain.com"

# NOTE: signed, short-lived public asset URLs (needed because Instagram fetches
# images by URL) are signed with NEXTAUTH_SECRET. That variable is already
# required above.

# ==========================================================================
# ---- Meta / Instagram publishing (OPTIONAL) ------------------------------
# ==========================================================================
# Instagram has NO self-serve posting API. Publishing a post with its graphic
# to Instagram requires ALL of the following:
#   1. A Meta app — https://developers.facebook.com/apps
#   2. An Instagram account converted to Business or Creator
#   3. That account linked to a Facebook Page
#   4. App Review approval for the `instagram_content_publish` permission
#
# Redirect URI to register on the Meta app:
#   https://your-domain.com/api/connectors/meta/callback
#
# Until these exist, Content Studio still generates Instagram-shaped graphics
# and queues Instagram posts; publishing routes to the "copy for manual
# posting" fallback and says exactly what is missing. It never reports a post
# as published when it was not.
#
# Meta must be able to FETCH the generated image over the public internet, so
# APP_URL has to point at a publicly reachable deployment for IG publishing.
# META_CLIENT_ID=""
# META_CLIENT_SECRET=""
# Optional Graph API version pin.
# META_GRAPH_VERSION="v21.0"

# ==========================================================================
# ---- Autonomous agent — the weekly briefing ------------------------------
# ==========================================================================
# Aura's weekly cycle. Every Monday it writes the week's posts, generates a
# graphic for each, and assembles the briefing that the dashboard home shows.
#
#   POST /api/cron/briefing    weekly (early Monday)
#   Vercel Cron: { "path": "/api/cron/briefing", "schedule": "0 5 * * 1" }
#   curl -X POST .../api/cron/briefing -H "authorization: Bearer $CRON_SECRET"
#
# Protected by the same CRON_SECRET as every other job. Safe to run more than
# once: it is idempotent per company per week, so a retry re-assembles the
# briefing without writing a second set of posts or paying twice for graphics.
#
# It needs no new variables. What it can DO depends on what is already set:
#   · ANTHROPIC_API_KEY / GEMINI_API_KEY  → it writes posts (without: none)
#   · an image provider key               → it illustrates them (without: text only)
# With neither, it still assembles the briefing and says plainly what it could
# not do — it never fabricates a week's work.
#
# Per-workspace control lives in Company.preferences.autopilot (no env var):
#   { "enabled": false }          turn the agent off for that workspace
#   { "postsPerWeek": 2 }         how much to write (0-5, default 3)
#   { "generateGraphics": false } write posts but skip the images

# ==========================================================================
# ---- Model tiers (cost control) ------------------------------------------
# ==========================================================================
# Not every task deserves the flagship model. Calls are classified into three
# tiers, and each tier maps to a model chosen for that class of work:
#
#   cheap     Haiku 4.5   $1 / $5 per MTok   extraction, scoring, diffs
#   standard  Sonnet 5    $2 / $10           digests, drafts, summaries
#   premium   Opus 4.8    $5 / $25           post copy, plans, recommendations
#
# The rule: does a human read the output as the product? Post copy, the monthly
# calendar and strategic recommendations do — those stay premium. Extraction,
# classification and internal summaries do not.
#
# Nothing needs to be set. These only override the defaults:
# ANTHROPIC_MODEL_CHEAP="claude-haiku-4-5"
# ANTHROPIC_MODEL_STANDARD="claude-sonnet-5"
# ANTHROPIC_MODEL_PREMIUM="claude-opus-4-8"
#
# ANTHROPIC_MODEL (above) still pins EVERY tier to one model, exactly as it did
# before tiering existed — so a deployment that set it keeps its old behaviour.
#
# NOTE: Haiku rejects the `effort` parameter with a 400. The client omits it for
# Haiku automatically; if you point a tier at another model that rejects it,
# extend the capability table in server/ai/claude.ts rather than removing the
# parameter globally.

# ---- Agnes AI (text-to-image) --------------------------------------------
# Used by POST /api/generate-image.
#
# SERVER-SIDE ONLY. Do not add a NEXT_PUBLIC_ prefix to the key: Next inlines
# every NEXT_PUBLIC_* value into the client bundle at build time, which would
# publish the credential to every visitor.
AGNES_API_KEY=""
# Base URL without a trailing slash. The route appends /images/generations.
#
# Note the /api/v1 prefix. Probing the host showed every path under /v1
# returning 404 while the same paths under /api/v1 return 401 — the routes
# live there. /v1 is a plausible-looking guess that silently never works.
AGNES_API_BASE_URL="https://api.agnes-ai.com/api/v1"
AGNES_IMAGE_MODEL="agnes-image-2.0-flash"
