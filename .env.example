# ==========================================================================
# Botella Aura — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---- Database (PostgreSQL) ------------------------------------------------
# Local dev example: postgresql://postgres:postgres@localhost:5432/botella_aura
# Use a pooled connection string in production (e.g. Supabase/Neon pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/botella_aura?schema=public"

# ---- NextAuth -------------------------------------------------------------
# The canonical URL of your app. In prod set to https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"
# Secret used to encrypt JWTs / session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# ---- Google OAuth ---------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Application encryption key -------------------------------------------
# AES-256-GCM key used to encrypt sensitive tokens at rest (e.g. the
# LinkedIn access/refresh tokens scaffolded for Sprint 2).
# MUST be 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# ==========================================================================
# ---- Sprint 2+ placeholders (not used in Sprint 1, documented early) -----
# ==========================================================================

# ---- LinkedIn OAuth (Sprint 2 — official API only, no scraping) ----------
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# ---- Transactional email (Sprint 2 — password reset / invites) -----------
# Sprint 1 logs emails to the console via lib/email.ts. To go live, set a
# provider key and swap the transport in lib/email.ts.
# RESEND_API_KEY=""
# EMAIL_FROM="Botella Aura <no-reply@botella.ai>"

# ---- AI provider (Sprint 3 — Content Studio / Trend Hunter) --------------
# ANTHROPIC_API_KEY=""
