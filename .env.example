# ==========================================================================
# Botella Aura — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---- Database (PostgreSQL) ------------------------------------------------
# Local dev example: postgresql://postgres:postgres@localhost:5432/botella_aura
# Use a pooled connection string in production (e.g. Supabase/Neon pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/botella_aura?schema=public"

# Direct (non-pooled) connection, used ONLY by `prisma migrate`.
# - Locally: set it to the same value as DATABASE_URL.
# - On Neon/Supabase: DATABASE_URL = the POOLED string, DIRECT_URL = the DIRECT
#   string. Migrations fail through a pooler (PgBouncer breaks advisory locks).
# If your provider gives only one URL, set both to that same URL — always safe.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/botella_aura?schema=public"

# ---- NextAuth -------------------------------------------------------------
# The canonical URL of your app. In prod set to https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"
# Secret used to encrypt JWTs / session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# ---- Google OAuth ---------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Application encryption key -------------------------------------------
# AES-256-GCM key used to encrypt sensitive tokens at rest (e.g. the
# LinkedIn access/refresh tokens scaffolded for Sprint 2).
# MUST be 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# ==========================================================================
# ---- Sprint 2 — LinkedIn + Trend Intelligence ----------------------------
# ==========================================================================

# ---- Anthropic (Claude) — powers trend digest AI -------------------------
# Create a key at https://console.anthropic.com  → API Keys.
# Without this, digests fall back to a non-AI summary (clearly labeled).
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL="claude-opus-4-8"

# ---- LinkedIn OAuth (Sprint 2 — official API only, NEVER scraping) -------
# Create an app at https://www.linkedin.com/developers/apps (needs a Company
# Page). Add the product "Sign In with LinkedIn using OpenID Connect".
# Add this exact Authorized redirect URL in the app's Auth tab:
#   http://localhost:3000/api/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Sprint 3 — Company Page auto-publish (PENDING LinkedIn Community Management
# API approval). Set the organization URN you administer, e.g.
# "urn:li:organization:12345678". Until this + the w_organization_social scope
# exist, Content Studio uses the "copy for manual posting" fallback.
# LINKEDIN_ORG_URN=""

# ---- Reddit API (Sprint 2 — trend source, read-only app-only token) ------
# Create an app at https://www.reddit.com/prefs/apps → type "script"/"web app".
# USER_AGENT is required by Reddit's API rules; identify your app + a contact.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="botella-aura/0.1 (by u/your-reddit-username)"

# ---- X / Twitter (Sprint 2 — OPTIONAL trend source) ----------------------
# Feature-flagged OFF unless a bearer token is present. No scraping.
# TWITTER_BEARER_TOKEN=""

# ---- Cron protection (Sprint 2 — scheduled digest job) -------------------
# Shared secret required to call POST /api/cron/trends. Generate with:
#   openssl rand -base64 32
CRON_SECRET=""

# Hacker News (Firebase API) and Google News (RSS) need NO credentials.
# The same CRON_SECRET also protects the Sprint 4 jobs:
#   POST /api/cron/competitors  (weekly competitor tracking + report)
#   POST /api/cron/outreach     (daily lead-signal detection)

# ==========================================================================
# ---- Sprint 4 (Competitors, Extension, Outreach, Engagement) -------------
# ==========================================================================

# ---- GitHub API (OPTIONAL) — competitor + outreach public-activity source -
# Works unauthenticated (60 req/hr). A token raises the limit to 5000/hr and is
# recommended if you track several competitors / run detection often.
# Create a fine-grained or classic token (no scopes needed for public data) at
# https://github.com/settings/tokens
# GITHUB_TOKEN=""

# ---- Crunchbase API (OPTIONAL) — outreach funding signals ----------------
# Paid/gated. When unset, the Crunchbase source is skipped (clearly flagged in
# the UI); GitHub + news + hiring RSS still run. No data is ever fabricated.
# CRUNCHBASE_API_KEY=""

# ---- Chrome extension origin (OPTIONAL, production) ----------------------
# The /api/extension/* routes are bearer-authenticated (no cookies), so CORS
# allows any chrome-extension:// origin by default (fine for unpacked dev, which
# gets a random id each load). For a PUBLISHED extension, pin its exact origin:
# EXTENSION_ALLOWED_ORIGIN="chrome-extension://<your-published-extension-id>"

# ==========================================================================
# ---- Later-sprint placeholders (documented early) ------------------------
# ==========================================================================

# ---- Transactional email (password reset / invites) ----------------------
# lib/email.ts logs to console until a provider key is set (no call-site change)
# RESEND_API_KEY=""
# EMAIL_FROM="Botella Aura <no-reply@botella.ai>"
