{
  "manifest_version": 3,
  "name": "Botella Aura — Action Layer",
  "version": "0.3.0",
  "description": "Review and send your approved Botella Aura posts — text and generated graphics — on LinkedIn. One human click per action. No automation.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://*.netlify.app/*",
    "https://*.up.railway.app/*",
    "https://*.botella.ai/*",
    "https://*.linkedin.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Botella Aura"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://localhost:3000/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*",
        "https://*.up.railway.app/*",
        "https://*.botella.ai/*"
      ],
      "js": ["content/pairing.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/linkedin.js"],
      "css": ["content/linkedin.css"],
      "run_at": "document_idle"
    }
  ]
}
